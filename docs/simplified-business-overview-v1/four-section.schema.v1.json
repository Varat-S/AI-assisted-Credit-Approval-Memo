{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "document": {
      "const": "business_overview_four_section_memo"
    },
    "schema_version": {
      "const": "bo-four-section-memo-1.0.0"
    },
    "design_basis": {
      "type": "object",
      "properties": {
        "assembler_version": {
          "const": "bo-four-section-assembler-1.0.0"
        },
        "selection_policy_version": {
          "type": "string"
        }
      },
      "required": [
        "assembler_version",
        "selection_policy_version"
      ],
      "additionalProperties": false
    },
    "example_only": {
      "type": "boolean"
    },
    "identity": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "analysis_run_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_snapshot_version": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_snapshot_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reporting_company": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_cutoff_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "conclusion_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "orchestrator_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "case_id",
        "analysis_run_id",
        "evidence_snapshot_version",
        "evidence_snapshot_hash",
        "reporting_company",
        "as_of_date",
        "evidence_cutoff_timestamp",
        "conclusion_id",
        "orchestrator_run_id"
      ],
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "memo_completeness": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "conclusion_status": {
          "type": "string"
        },
        "validators_enforced": {
          "type": "boolean"
        },
        "independent_challenge_status": {
          "type": "string"
        },
        "human_review_status": {
          "const": "pending"
        },
        "execution_mode": {
          "type": "string"
        },
        "visible_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "memo_completeness",
        "conclusion_status",
        "validators_enforced",
        "independent_challenge_status",
        "human_review_status",
        "execution_mode",
        "visible_warnings"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "stage_name": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "hash_kind": {
            "const": "canonical_stage"
          },
          "binding": {
            "const": "same_run_verified"
          }
        },
        "required": [
          "artifact_id",
          "stage_name",
          "source_path",
          "sha256",
          "content_hash",
          "hash_kind",
          "binding"
        ],
        "additionalProperties": false
      }
