{% macro value(node) -%}
{% if node is mapping %}<dl class="bo-fields">{% for key,item in node.items() %}<div><dt>{{ key|bo_label }}</dt><dd>{{ value(item) }}</dd></div>{% endfor %}</dl>{% elif node is sequence and node is not string %}<ol>{% for item in node %}<li>{{ value(item) }}</li>{% else %}<li>No recorded items.</li>{% endfor %}</ol>{% elif node is none %}Not recorded{% else %}<span class="bo-verbatim">{{ node }}</span>{% endif %}
{%- endmacro %}
{% set audit_job=job if job is defined else none %}
{% set audit_href=bo_audit_url(bo,audit_job) %}
{% macro quick_evidence(ids, qualifications=[], figures=[]) %}
<details class="bo-quick-evidence bo-print-expand"{% if expand_evidence %} open{% endif %}><summary>Supporting evidence</summary><div class="bo-evidence-body">
{% set found=namespace(count=0) %}{% for source in bo.evidence_sources if source.evidence_id in ids %}{% set found.count=found.count+1 %}<div class="bo-source"><strong>{{ source.filename or source.document_name or 'Recorded company filing' }}</strong><p class="bo-caption">{{ source.section or 'Section not recorded' }}{% if source.page %} · Page {{ source.page }}{% elif source.location is not none and source.location is defined %} · Location {{ source.location }}{% endif %}</p>{% if source.excerpt %}<blockquote>{{ source.excerpt }}</blockquote>{% else %}<p>Source quotation not recorded.</p>{% endif %}{% if source.source_url and source.source_url|bo_safe_url %}<a href="{{ source.source_url|bo_safe_url }}" target="_blank" rel="noopener noreferrer">Open recorded source</a> · {% endif %}<a href="{{ bo_audit_url(bo,audit_job,source.evidence_id) }}">View source in Audit &amp; Review</a></div>{% endfor %}
{% if found.count < ids|length %}<p class="bo-caption">Some supporting quotations are not available in this saved memo. Their recorded references remain in Audit &amp; Review.</p>{% endif %}
{% for text in qualifications if text %}<p class="bo-qualification">{{ text|bo_notice }}</p>{% endfor %}{% if figures %}<p class="bo-caption">Recorded supporting figures</p>{{ value(figures) }}{% endif %}<p><a href="{{ audit_href }}">Open full Audit &amp; Review</a></p></div></details>
{% endmacro %}
{% macro report_table(records) %}{% if records %}{% set ns=namespace(keys=[]) %}{% for row in records if row is mapping %}{% for key in row if key not in ns.keys %}{% set ns.keys=ns.keys+[key] %}{% endfor %}{% endfor %}<div class="memo-table-wrap"><table class="memo-table"><thead><tr>{% for key in ns.keys %}<th>{{ key|bo_label }}</th>{% endfor %}</tr></thead><tbody>{% for row in records %}<tr>{% for key in ns.keys %}<td>{{ value(row.get(key)) }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>{% endif %}{% endmacro %}
{% macro debt_table(records, adjustments=false) %}
{% if records %}<p class="bo-scroll-hint">Scroll horizontally to view all debt columns.</p><div class="bo-table-scroll memo-table-wrap" tabindex="0" role="region" aria-label="Debt obligations summary; scroll horizontally if needed"><table class="bo-table bo-debt-table memo-table"><thead><tr><th scope="col">Instrument / borrower</th><th scope="col">{{ 'Adjustment ($M)' if adjustments else 'Outstanding / drawn ($M)' }}</th><th scope="col">Maturity</th><th scope="col">Security / creditor priority</th></tr></thead><tbody>
{% for row in records %}<tr class="bo-debt-row"><td>{% for key in ['senior_note_series','obligation_facility','label','legal_borrower'] if key in row %}<div>{{ row[key] }}</div>{% endfor %}</td><td class="numeric">{% for key in ['principal_amount_m','principal_drawn_m','amount_m'] if key in row %}<div>{{ row[key]|bo_amount }}</div>{% else %}Not recorded{% endfor %}</td><td>{% for key in ['maturity','maturity_year'] if key in row %}<div>{{ row[key] }}</div>{% else %}Not recorded{% endfor %}</td><td>{% if row.collateral_security_status is defined %}<div>{{ row.collateral_security_status|bo_classification('security') }}</div>{% endif %}{% if row.priority_ranking_tier is defined %}<div>{{ row.priority_ranking_tier|bo_classification('priority') }}</div>{% endif %}{% if row.collateral_security_status is not defined and row.priority_ranking_tier is not defined %}Not recorded{% endif %}</td></tr>
<tr class="bo-debt-detail-row"><td colspan="4"><details class="bo-debt-details bo-print-expand"{% if expand_evidence %} open{% endif %}><summary aria-label="Details for {{ row.senior_note_series or row.obligation_facility or 'recorded debt obligation' }}">Details</summary><div class="bo-debt-extra">{% for key,val in row.items() if key not in bo_debt_summary_fields %}<div><strong>{{ 'Facility limit ($M), not outstanding debt' if key=='available_facility_limit_m' else key|bo_label }}</strong><p>{{ val|bo_amount if key.endswith('_m') else val|bo_classification('transaction') if key=='transaction_category' else value(val) }}</p></div>{% endfor %}{% if row.priority_ranking_tier is defined %}<div><strong>Recorded ranking classification</strong><p>{{ row.priority_ranking_tier }}</p></div>{% endif %}{% if row.collateral_security_status is defined %}<div><strong>Recorded security classification</strong><p>{{ row.collateral_security_status }}</p></div>{% endif %}</div></details></td></tr>
{% endfor %}</tbody></table></div>{% else %}<p class="bo-caption">No recorded obligations in this schedule.</p>{% endif %}
{% endmacro %}
{% include 'bo_consolidated_style.html.j2' %}
<div class="consolidated-bo">
{% if job is not defined and bo.execution_mode=='offline_simulation' %}<p class="notice-warning">Illustrative offline simulation. Not live company verification.</p>{% endif %}
<p class="bo-governance notice-warning">{{ bo.governance.text }} Review status: {{ bo.governance.human_review_status|bo_classification }}.</p>
<p class="bo-print-only">Case: {{ bo.case_id }} · Run: {{ bo.analysis_run_id }} · Audit: {{ audit_href }}</p>
{% for section in bo.sections %}{% set index=loop.index %}<section class="bo-section" id="bo-section-{{ index }}"><div class="bo-section-head"><span class="bo-number">{{ '%02d'|format(index) }}</span><h2>{{ section.title }}</h2></div>
{% if section.status!='complete' %}<p class="bo-caption">{{ section.status|bo_classification }}</p>{% endif %}{% for text in section.limitations %}<p class="notice-warning">{{ text|bo_notice }}</p>{% endfor %}
{% if index==1 %}<div class="bo-two-columns"><div><h3>Corporate Structure</h3>{% for item in section['items'] if item.field_path[-1]=='artifact' %}{% set diagram=item.content|bo_diagram %}{% if diagram %}<div class="bo-diagram-scroll" tabindex="0" role="region" aria-label="Corporate structure diagram"><img class="bo-diagram" src="{{ diagram }}" alt="Preserved Module 3 corporate structure diagram"></div><p class="bo-caption">{{ item.content.simulation_disclaimer }}</p><details class="bo-provenance"><summary>Inspect full-size structure</summary><div class="bo-diagram-scroll"><img src="{{ diagram }}" style="display:block;max-width:none" alt="Original-size preserved corporate structure diagram"></div></details>{% else %}{{ value(item.content) }}{% endif %}{% else %}<p>Corporate structure not recorded.</p>{% endfor %}</div>
<div><h3>Debt Obligations</h3>{% for item in section['items'] if item.field_path[-1]=='deliverable_1' %}{% for key,data in item.content.items() if key in ['senior_notes_schedule','non_note_obligations_schedule','reconciling_items'] and data %}<h3>{{ key|bo_label }}</h3>{{ debt_table(data,key=='reconciling_items') }}{% endfor %}{% if item.content.creditor_priority_framework and item.content.creditor_priority_framework.consolidated_total_indebtedness_m is defined %}<p class="bo-caption">Recorded consolidated total indebtedness ($M): <strong>{{ item.content.creditor_priority_framework.consolidated_total_indebtedness_m|bo_amount }}</strong></p>{% endif %}<details class="bo-quick-evidence bo-print-expand"{% if expand_evidence %} open{% endif %}><summary>Debt source and qualifications</summary>{% if item.content.extraction_source %}{{ value(item.content.extraction_source) }}{% endif %}{% for key,val in item.content.items() if key not in ['senior_notes_schedule','non_note_obligations_schedule','reconciling_items','extraction_source'] %}<p class="bo-caption">{{ key|bo_label }}</p>{{ value(val) }}{% endfor %}<a href="{{ audit_href }}">View complete debt assessment in Audit &amp; Review</a></details>{% else %}<p>Debt obligations not recorded.</p>{% endfor %}</div></div>
{% elif index==2 %}{% for item in section['items'] %}{% set m=item.content %}{% if m.observations is defined %}{% if m.overall_assessment.policy %}<p>{{ m.overall_assessment.policy }}</p>{% endif %}{% if m.overall_assessment.information_gaps %}<p class="notice-warning">Management information is incomplete. Review the supporting evidence and outstanding limitations.</p>{% endif %}{% for observation in m.observations %}<div class="bo-point"><p>{{ observation.text }}</p><details class="bo-quick-evidence bo-print-expand"{% if expand_evidence %} open{% endif %}><summary>Supporting evidence</summary>{% for c in m.citations or [] if c.citation_id in (observation.citation_ids or []) %}<blockquote>{{ c.quote }}</blockquote><p class="bo-caption">Management filing{% if c.source_id %} · Recorded reference: {{ c.source_id }}{% endif %}{% if c.physical_page %} · Page {{ c.physical_page }}{% elif c.page %} · Page {{ c.page }}{% endif %}</p>{% else %}<p>No quotation is recorded for this observation.</p>{% endfor %}<a href="{{ audit_href }}">View management evidence in Audit &amp; Review</a></details></div>{% endfor %}{% for text in m.limitations or [] %}<p class="bo-qualification">{{ text|bo_notice }}</p>{% endfor %}{% else %}{{ value(m) }}{% endif %}{% endfor %}
{% elif index==3 %}{% if section.synthesis %}{% set s=section.synthesis %}<p>{{ s.overall_assessment.text }}</p>{% if s.overall_assessment.analysis %}{% for paragraph in s.overall_assessment.analysis.values() %}<p>{{ paragraph }}</p>{% endfor %}{% endif %}{% if s.overall_assessment.uncertainty %}<p class="bo-qualification">{{ s.overall_assessment.uncertainty }}</p>{% endif %}{% for text in s.overall_assessment.counterevidence %}<p class="bo-qualification">{{ text }}</p>{% endfor %}{{ quick_evidence(s.overall_assessment.evidence_ids,[],s.overall_assessment.quoted_values) }}{% for gap in s.coverage_gaps %}<p class="bo-qualification">{{ gap|bo_notice }}</p>{% endfor %}
{% for point in s.key_drivers %}<div class="bo-point" id="bo-point-{{ point.claim_id }}"><h3>{{ point.title or point.text }}</h3>{% if point.title %}<p>{{ point.text }}</p>{% endif %}{% if point.analysis %}<p>{{ point.analysis.company_evidence }}</p><p>{{ point.analysis.revenue_or_cost_mechanism }}</p><p>{{ point.analysis.competitive_and_credit_implication }}</p>{% endif %}{% if point.uncertainty %}<p class="bo-qualification">{{ point.uncertainty }}</p>{% endif %}{% for text in point.counterevidence %}<p class="bo-qualification">{{ text }}</p>{% endfor %}{{ quick_evidence(point.evidence_ids,[],point.quoted_values) }}</div>{% endfor %}{% for text in s.residual_uncertainty %}<p class="bo-qualification">{{ text }}</p>{% endfor %}{% endif %}
{% elif index==4 %}{% for item in section['items'] if item.field_path[-1]=='deliverable_2' %}{% if item.content.refinancing_log is defined %}<ol class="bo-timeline">{% for event in item.content.refinancing_log %}<li class="bo-event" data-event-index="{{ loop.index }}"><p class="bo-event-date">{{ event.execution_date_fiscal_period or 'Date not recorded' }}</p><h3>{{ event.obligation_series_description or 'Instrument not recorded' }}</h3>{% for key,val in event.items() if key not in ['execution_date_fiscal_period','obligation_series_description'] %}<div><span class="bo-caption">{{ key|bo_label }}:</span> {{ val|bo_amount if key.endswith('_m') else val|bo_classification('transaction') if key=='transaction_category' else value(val) }}</div>{% endfor %}</li>{% endfor %}</ol>{% endif %}{% if item.content.refinancing_capacity_discipline_verdict %}<div class="bo-conclusion"><h3>Refinancing conclusion</h3><p>{{ item.content.refinancing_capacity_discipline_verdict }}</p></div>{% endif %}<details class="bo-quick-evidence bo-print-expand"{% if expand_evidence %} open{% endif %}><summary>Refinancing evidence and supporting figures</summary>{% for key,val in item.content.items() if key not in ['refinancing_log','refinancing_capacity_discipline_verdict'] %}<p class="bo-caption">{{ key|bo_label }}</p>{{ value(val) }}{% endfor %}<a href="{{ audit_href }}">View full refinancing assessment</a></details>{% endfor %}
{% for item in section['items'] if item.field_path[-1]=='deliverable_4' %}<div class="bo-conclusion"><h3>Credit conclusion</h3>{% if item.content.core_credit_assessment %}<p>{{ item.content.core_credit_assessment }}</p>{% endif %}{% if item.content.evidence_synthesis_narrative %}<p>{{ item.content.evidence_synthesis_narrative }}</p>{% endif %}{% if item.content.strategy_capital_supplement %}{% for finding in item.content.strategy_capital_supplement.findings or [] %}<div class="bo-point"><p>{{ finding.claim }}</p>{% if finding.credit_mechanism %}<p>{{ finding.credit_mechanism }}</p>{% endif %}{% for gap in finding.missing_information or [] %}<p class="bo-qualification">{{ gap|bo_notice }}</p>{% endfor %}{% for note in finding.validation_notes or [] %}<p class="bo-qualification">{{ note|bo_notice }}</p>{% endfor %}{{ quick_evidence(finding.supporting_evidence_ids or []) }}</div>{% endfor %}{% endif %}<details class="bo-quick-evidence bo-print-expand"{% if expand_evidence %} open{% endif %}><summary>Conclusion evidence and qualifications</summary>{% for key,val in item.content.items() if key not in ['core_credit_assessment','evidence_synthesis_narrative'] %}<p class="bo-caption">{{ key|bo_label }}</p>{{ value(val) }}{% endfor %}</details></div>{% endfor %}
{% else %}{% for item in section['items'] %}{% if item.content is sequence and item.content is not string %}{% for finding in item.content %}<div class="bo-point"><p>{{ finding.claim }}</p>{% for key,val in (finding.interpretation or {}).items() %}{% if val is string %}<p>{{ val }}</p>{% else %}{{ value(val) }}{% endif %}{% endfor %}{% if finding.credit_mechanism %}<p>{{ finding.credit_mechanism }}</p>{% endif %}{% for gap in finding.missing_information or [] %}<p class="bo-qualification">{{ gap|bo_notice }}</p>{% endfor %}{% if finding.table %}{{ report_table(finding.table) }}{% endif %}{% for figure in finding.quoted_values or [] %}<p>{{ figure.value|bo_amount }} {{ figure.unit or '' }} {{ figure.period or '' }}</p>{% endfor %}{% for note in finding.validation_notes or [] %}<p class="bo-qualification">{{ note|bo_notice }}</p>{% endfor %}{{ quick_evidence(finding.supporting_evidence_ids or []) }}</div>{% endfor %}{% else %}{{ value(item.content) }}{% endif %}{% endfor %}{% endif %}</section>{% endfor %}
<p class="bo-caption"><a href="{{ audit_href }}">Audit &amp; Review — complete findings, source records and validation history</a></p>
<details class="bo-provenance"><summary>Saved report provenance</summary><p>Case: {{ bo.case_id }} · Run: {{ bo.analysis_run_id }} · {{ bo.execution_mode }}</p>{{ value(bo.sources) }}{% for section in bo.sections %}{% for text in section.limitations %}<p>{{ text }}</p>{% endfor %}{% for item in section['items'] %}<p>{{ item.source_stage }} · {{ item.field_path|join('.') }} · {{ item.content_hash }}</p>{% endfor %}{% endfor %}{{ value(bo.evidence_sources) }}</details>
</div>
<script>
(function(){var host=document.currentScript.previousElementSibling,states=null;if(!host)return;window.addEventListener('beforeprint',function(){if(states)return;states=Array.from(host.querySelectorAll('.bo-print-expand')).map(function(d){var was=d.open;d.open=true;return [d,was];});});window.addEventListener('afterprint',function(){if(states)states.forEach(function(s){s[0].open=s[1];});states=null;});})();
</script>
