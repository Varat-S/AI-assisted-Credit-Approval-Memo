<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Financial Overview - {{ memo.case.borrower or memo.case.case_id }}</title>
{# Standalone page (the saved financial_memo.html, and the FO workbench's preview): the same section the analysis's
   Memo tab shows, with the memo-* classes styled here since this file has to stand on its own. #}
<style>
  body { font-family: Georgia, "Times New Roman", serif; color: #192b3b; background: #ffffff; max-width: 960px; margin: 1.8rem auto; padding: 0 1.4rem; line-height: 1.55; font-size: 15px; }
  h1 { font-size: 1.7rem; margin: 0 0 .3rem; }
  h3 { font-size: 1.05rem; margin: 1.6rem 0 .5rem; padding-top: .9rem; border-top: 1px solid #e4e9e7; }
  h3:first-of-type { border: 0; padding-top: 0; }
  p, li { font-size: .92rem; } ul { margin: .3rem 0 .6rem 1.2rem; padding: 0; }
  a { color: #1e5d60; }
  .meta, .technical-note, .memo-empty, .notice-warning, .memo-scores, .memo-table, .banner { font-family: Arial, Helvetica, sans-serif; }
  .meta { font-size: .8rem; color: #62707b; }
  .banner { font-size: .85rem; padding: .6rem .8rem; margin: .8rem 0; border-left: 4px solid #8a6d1c; background: #fbf6e6; }
  .banner.sim, .banner.block { border-color: #9a3324; background: #fbeeea; } .banner.block { font-weight: bold; }
  .memo-scores { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 14px 0; }
  .memo-scores > div { padding: 10px 14px; border: 1px solid #dce2e1; border-left: 4px solid #397477; border-radius: 8px; background: #f5f8f7; }
  .memo-scores span { display: block; font-size: .75rem; color: #62707b; } .memo-scores strong { font-size: 1.15rem; }
  .technical-note { font-size: .8rem; color: #62707b; } .memo-empty { font-size: .85rem; color: #72808a; }
  .notice-warning { padding: 10px 14px; border-left: 3px solid #c69a44; background: #fbf7ed; font-size: .85rem; margin: 12px 0; }
  .notice-warning ul { margin-bottom: 0; }
  .memo-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; } .memo-columns h3 { border: 0; padding-top: 0; }
  .memo-table-wrap { overflow-x: auto; }
  .memo-table { width: 100%; font-size: .8rem; border-collapse: collapse; }
  .memo-table th, .memo-table td { padding: 7px 9px; text-align: left; vertical-align: top; border-bottom: 1px solid #e2e8e5; }
  .memo-table th { color: #5c7175; background: #f5f8f7; } .memo-table small { color: #62707b; }
  .memo-table tr.memo-note-row td { border-top: 0; padding-top: 0; background: #fafbfa; }
  .memo-risk { display: inline-block; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; padding: 1px 6px; border-radius: 4px; border: 1px solid #c3cad3; color: #404b59; white-space: nowrap; }
  .memo-risk.very-low, .memo-risk.low { border-color: #2f6b45; color: #2f6b45; } .memo-risk.moderate { border-color: #8a6d1c; color: #8a6d1c; }
  .memo-risk.elevated, .memo-risk.high, .memo-risk.very-high { border-color: #9a3324; color: #9a3324; }
  @media (max-width: 700px) { .memo-columns { grid-template-columns: 1fr; gap: 0; } }
</style>
</head>
<body>
<h1>Financial Overview</h1>
<div class="meta">
  {{ memo.case.borrower }}{% if memo.case.ticker %} ({{ memo.case.ticker }}){% endif %} &middot; case {{ memo.case.case_id }} &middot; {{ memo.case.form }} for the period ending {{ memo.case.period_end or 'unknown' }} (FY{{ memo.case.fiscal_year or '?' }})
  {% if memo.case.source %}&middot; SEC accession {{ memo.case.source.accession }}, filed {{ memo.case.source.filing_date }}{% endif %}<br>
  Run {{ memo.run.run_id }} &middot; {{ memo.run.started_at[:16]|replace('T', ' ') if memo.run.started_at }} &middot; engine {{ memo.run.engine_version }}{% if memo.run.agent_model %} &middot; agent model {{ memo.run.agent_model }}{% endif %} &middot; scope: Financial Overview only
</div>
{% if memo.run.agent_mode == 'scripted' %}<div class="banner sim">{{ memo.run.agent_mode_text }}</div>{% endif %}
{% if memo.status.blocking %}<div class="banner block">Status: {{ (memo.status.run_status or 'unknown')|replace('_', ' ') }}. {{ memo.status.text }}</div>{% endif %}
{% include 'fo_memo_section.html.j2' %}
</body>
</html>
