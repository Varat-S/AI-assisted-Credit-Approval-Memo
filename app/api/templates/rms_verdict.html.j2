{# The credit view's RMS verdict (the loan request form is rms_request.html.j2). Needs view, rms, r, rec, fo, fo_run, bo_run and the credit_macros. #}
<section id="verdict"><h2>Verdict</h2>
{% if r %}{% set kind = 'approve' if r.verdict.startswith('approve') or r.verdict == 'counter_offer' else r.verdict %}
<div class="card verdict {{ kind }}">
<p class="big">{{ st(r.verdict) }}{% if r.approved_amount_m is not none %} · {{ usd(r.approved_amount_m) }}{% if r.approved_amount_m != r.requested_amount_m %} (counter-offer){% endif %}{% endif %}</p>
<p>{% if r.requested_amount_m is none %}Debt capacity report: no requested amount, no verdict{% else %}Requested {{ usd(r.requested_amount_m) }}{% endif %} · derived debt capacity {{ usd(r.derived_capacity_m) }}{% if r.utilisation is not none %} · utilisation {{ '{:.0%}'.format(r.utilisation) }}{% endif %} · grade {{ r.rating or '—' }} ({{ r.level or '—' }}) · needs human review</p>
{% if rms.stale %}<div class="notice" id="stale"><strong>Out of date:</strong> {{ rms.stale|join('; ') }}. <form method="post" action="/cases/{{ view.case_id }}/credit/assess" style="display:inline">
<input type="hidden" name="fo_run" value="{{ fo_run }}"><input type="hidden" name="bo_run" value="{{ bo_run }}">{% if analysis %}<input type="hidden" name="job" value="{{ analysis.job.job_id }}">{% endif %}
<input type="hidden" name="requested_amount_m" value="{{ rms.request.requested_amount_m if rms.request.requested_amount_m is not none else '' }}"><input type="hidden" name="tenor_years" value="{{ rms.request.tenor_years }}">
<input type="hidden" name="interest_rate" value="{{ rms.request.interest_rate if rms.request.interest_rate is not none else '' }}">
<button type="submit">Re-assess now</button></form></div>{% endif %}
{% if r.gates %}<p><strong>Gates holding:</strong></p><ul>{% for g in r.gates %}<li>{{ g }}</li>{% endfor %}</ul>{% endif %}
{% if r.warnings %}<p class="warn"><strong>Warnings</strong> (gates waived because the BO reviewer accepted the handoff):</p><ul>{% for g in r.warnings %}<li>{{ g }}</li>{% endfor %}</ul>{% endif %}
<p class="subtle">Assessment <code>{{ r.run_id }}</code>{% if r.supersedes %} (supersedes <code>{{ r.supersedes }}</code>){% endif %} · <code>{{ r.output }}</code></p>
</div>
{% else %}<p>No assessment of these runs yet. Enter the requested loan under <a href="#assess-form">Loan request</a>, or leave it blank for a debt capacity report.</p>{% endif %}
</section>
