<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Credit Memos</title>{% include 'workspace_style.html.j2' %}<style>
.history-filters{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:14px;align-items:end;margin-bottom:24px}.history-filters label{font-size:.78rem;margin:0}.history-filters input,.history-filters select{margin:6px 0 0;min-height:42px;box-sizing:border-box;width:100%}.history-filters button{margin:0;min-height:42px}.history-row{display:flex;justify-content:space-between;gap:22px;padding:22px 0;border-bottom:1px solid var(--c-e1e6ed)}.history-row h3{font-size:1rem;margin:0}.history-row h3 a{text-decoration:none}.history-row p{margin:6px 0;font-size:.84rem;color:var(--c-64727b)}.history-row small{font-size:.73rem;overflow-wrap:anywhere}.history-status{text-align:right;min-width:160px;font-size:.78rem}.status-pill{display:inline-block;padding:4px 11px;border-radius:20px;background:var(--c-eef3f8);white-space:nowrap;font-size:.75rem}.status-pill.running,.status-pill.pending{background:var(--c-eaf4f2);color:var(--c-226c67)}.status-pill.completed{background:var(--c-edf4ef);color:var(--c-3a6949)}.status-pill.failed{background:var(--c-fbefec);color:var(--c-9e483e)}.status-pill.interrupted,.status-pill.stopped{background:var(--c-faf3e4);color:var(--c-836328)}.history-status p{font-size:.76rem}.history-row .issue{color:var(--c-9e483e)}@media(max-width:760px){.history-filters{grid-template-columns:1fr 1fr}.history-row{flex-direction:column;gap:8px}.history-status{text-align:left}.history-filters .search-field{grid-column:1/-1}}
</style></head><body>{% set active='memos' %}{% include 'analysis_nav.html.j2' %}<header class="setup-header"><span class="eyebrow">Your analysis workspace</span><h1>Credit Memos</h1><p>Find an analysis, follow its progress or open its memo.</p><p><a href="/analysis/new?manage_filings=1#add-evidence">Add Company / Manage Filings</a></p></header><main><section class="setup-panel"><h2>Analysis history</h2>
<form class="history-filters" method="get" action="/credit-memos" aria-label="Filter analysis history"><label class="search-field" for="search">Company or run ID<input type="search" name="search" id="search" value="{{ search }}" placeholder="Search analyses"></label><label for="status">Execution status<select id="status" name="status"><option value="">All statuses</option>{% for status in statuses %}<option value="{{ status }}"{% if selected_status == status %} selected{% endif %}>{{ status|title }}</option>{% endfor %}</select></label><label for="mode">Validation mode<select id="mode" name="mode"><option value="">All modes</option><option value="standard"{% if selected_mode == 'standard' %} selected{% endif %}>Standard</option><option value="exploratory"{% if selected_mode == 'exploratory' %} selected{% endif %}>Exploratory</option></select></label><button class="primary-button" type="submit">Apply</button></form>
{% if not rows %}<p>No analyses match your search.</p><a href="/analysis/new">Set up a new analysis</a>{% endif %}
{% for row in rows %}<article class="history-row" data-job-id="{{ row.job.job_id }}"><div><h3><a href="{{ row.href }}" aria-label="{{ row.company }} — run {{ row.job.job_id }}">{{ row.company }}</a></h3><p>{{ 'Business Overview Only' if row.job.bo_only else 'Business + Financial Overview' }} · {{ row.mode|title }}</p><small>{{ row.date }} · {{ row.job.job_id }}</small>{% if row.issue %}<p class="issue">{{ row.issue }}</p>{% endif %}</div><div class="history-status"><span class="status-pill {{ row.execution }}">{{ 'Stopping' if row.job.stop_requested and row.execution in ['pending','running'] else row.execution|title }}</span><p>Credit memo: {{ row.governance }}</p></div></article>{% endfor %}</section></main></body></html>
