<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ document.filename }} · Source Viewer</title>{% include 'browser_style.html.j2' %}<style>
.source-document{max-width:1000px;margin:24px auto;padding:24px}.source-paragraph{scroll-margin-top:20px;margin:24px 0;padding:14px;border:1px solid var(--c-c7d5d4);border-radius:.3rem}.source-paragraph:target{border-color:var(--c-517273);background:var(--c-f5f8f7)}.source-line{display:grid;grid-template-columns:36px minmax(0,1fr);gap:12px;margin:6px 0}.source-line span{color:var(--c-62707b);text-align:right;font-size:.8rem}.source-line p{margin:0;overflow-wrap:anywhere}.source-note{font-size:.84rem;color:var(--c-62707b)}
</style></head><body><main class="source-document"><h1>{{ document.filename }}</h1><p class="source-note">Read-only text from the checksum-verified filing. Page labels are printed report page labels where detected. Paragraph numbers index the HTML text blocks on each page; line numbers use fixed 100-character wrapping in this viewer. These are navigation aids, not original report paragraph or line numbers. Tables and non-paragraph content may be omitted; consult the original filing for the complete report.</p>{% if original %}<p><a href="{{ original }}" target="_blank" rel="noopener noreferrer">Open Original 10-K</a></p>{% endif %}{% for p in paragraphs %}<section class="source-paragraph" id="{{ p.id }}"><h3>Page {{ p.page or 'Not Available' }} · Paragraph {{ p.paragraph }}</h3>{% for line in p.lines %}<div class="source-line"><span>{{ loop.index }}</span><p>{{ line }}</p></div>{% endfor %}</section>{% endfor %}</main></body></html>
