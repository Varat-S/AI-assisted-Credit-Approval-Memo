{# Shared header for every page of one analysis. Needs `analysis` from analysis_workspace.analysis_tabs(). #}
{% set job = analysis.job %}
<style>
.analysis-header{margin-bottom:22px}.analysis-header h1{margin:6px 0 8px}.analysis-meta{display:flex;flex-wrap:wrap;gap:6px 24px;font-size:.88rem;color:var(--c-62707b)}
.analysis-tabs{display:flex;flex-wrap:wrap;gap:4px;margin:20px 0 0;border-bottom:1px solid var(--c-d8e0df)}
.analysis-tabs a{padding:10px 14px;margin-bottom:-1px;border:1px solid transparent;border-radius:7px 7px 0 0;font-size:.88rem;font-weight:600;color:var(--c-315e62);text-decoration:none}
.analysis-tabs a[href]:hover{background:var(--c-f1f6f5)}
.analysis-tabs a[aria-current=page]{background:var(--c-ffffff);border-color:var(--c-d8e0df);border-bottom-color:var(--c-ffffff);color:var(--c-192b3b)}
.analysis-tabs a[aria-disabled=true]{color:var(--c-a3adb3);cursor:default}
</style>
<header class="setup-header analysis-header"><span class="eyebrow">Credit Memos · {% for tab in analysis.tabs if tab.key == analysis.current %}{{ tab.label }}{% endfor %}</span>
<h1>{{ job.metadata.company or job.folder }}</h1>
<div class="analysis-meta"><span>Reporting period: {{ analysis_period or job.metadata.reporting_period or 'Not recorded' }}</span><span>{{ 'Business Overview Only' if job.bo_only else 'Financial Overview Only' if job.fo_only else 'Business + Financial Overview' }}</span><span>{{ 'Standard' if job.bo_validators else 'Exploratory' }}</span><span data-execution-status>Execution: {{ (job.execution_status or 'not recorded')|title }}</span></div>
{% if not pdf %}<nav class="analysis-tabs" aria-label="Analysis sections">{% for tab in analysis.tabs %}<a data-tab="{{ tab.key }}"{% if tab.href %} href="{{ tab.href }}"{% else %} aria-disabled="true" title="Available when the report is recorded"{% endif %}{% if tab.key == analysis.current %} aria-current="page"{% endif %}>{{ tab.label }}</a>{% endfor %}</nav>{% endif %}
</header>
