<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pipeline Viewer V2 · Credit analysis</title>
{% include 'workspace_style.html.j2' %}{% include 'memo_typography.html.j2' %}
<style>
:root{color-scheme:light;--ink:var(--c-192b3b,#192b3b);--muted:var(--c-62707b,#62707b);--teal:var(--c-315e62,#315e62);--line:var(--c-dce2e1,#dce2e1)}*{box-sizing:border-box}body{height:100dvh;display:flex;flex-direction:column;overflow:hidden;margin:0;max-width:none;padding:0;background:var(--c-f5f6f4,#f5f6f4);color:var(--ink);font:14px 'Segoe UI',Arial,sans-serif}.top{flex-shrink:0;margin:0;border-radius:0;padding:20px 26px;background:#fff;border-bottom:1px solid var(--line)}.topline{display:flex;justify-content:space-between;align-items:center;gap:16px}.eyebrow{color:var(--teal);font-size:11px;letter-spacing:.15em;text-transform:uppercase;font-weight:700}h1{font:700 26px 'Segoe UI',Arial,sans-serif;margin:4px 0 0}a{color:var(--teal)}.subtitle{color:var(--muted);font-size:12px;margin:8px 0 16px}.controls{display:flex;align-items:center;gap:12px;flex-wrap:wrap}label{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px;margin:0}select,input,button{font:inherit;color:var(--ink);background:white;border:1px solid var(--c-c7d5d4,#c7d5d4);border-radius:6px;padding:8px 10px;max-width:100%;margin:0}select{min-width:180px;width:auto}button{cursor:pointer}button:hover{border-color:var(--teal);background:var(--c-edf4f2,#edf4f2)}button:focus-visible,select:focus-visible,input:focus-visible,.node:focus-visible{outline:3px solid var(--c-488c8c,#488c8c);outline-offset:3px}.notice{flex-shrink:0;margin:0;border-radius:0;border-left:0;padding:10px 26px;font-size:12px;background:var(--c-edf4f2,#edf4f2);color:var(--teal);border-bottom:1px solid var(--line)}.shell{display:flex;flex:1;min-height:0}.catalog{width:225px;flex-shrink:0;background:#fff;border-right:1px solid var(--line);padding:14px 10px;overflow:auto}.catalog input{width:100%;font-size:12px}.catalog h2{font-size:12px;color:var(--muted);margin:14px 8px 8px}.node-link{display:block;width:100%;border:0;border-radius:4px;text-align:left;padding:9px;font-size:12px;margin:2px 0;background:transparent}.node-link small{display:block;color:var(--muted);font-size:10px;margin-top:2px}.node-link[aria-current=true]{background:var(--c-edf4f2,#edf4f2);box-shadow:inset 3px 0 var(--teal)}.graph-area{flex:1;min-width:0;display:flex;flex-direction:column;position:relative}.toolbar{padding:10px 16px;display:flex;gap:6px;align-items:center;background:#fff;border-bottom:1px solid var(--line);flex-wrap:wrap}.toolbar button{font-size:12px}.toolbar .hint{font-size:11px;color:var(--muted);margin-left:auto}.graphwrap{flex:1;min-height:300px;overflow:hidden;background:radial-gradient(circle,var(--c-cfdad8,#cfdad8) 1px,transparent 1px) 0 0/22px 22px}#graph{width:100%;height:100%;touch-action:none;cursor:grab}#graph.panning{cursor:grabbing}.node{cursor:pointer}.node .box{fill:#fff;stroke:var(--c-b9cac7,#b9cac7);stroke-width:1.2}.node.illustration .box{stroke-dasharray:4 3;fill:var(--c-f7f9f8,#f7f9f8)}.node.selected .box,.node:hover .box{stroke:var(--c-1e5d60,#1e5d60);stroke-width:3}.node text{pointer-events:none;fill:var(--ink)}.node .label{font-size:11px;font-weight:600}.node .meta{font-size:9px;fill:var(--c-62707b,#62707b)}.edge{fill:none;stroke:var(--c-96aca7,#96aca7);stroke-width:1;marker-end:url(#arrow)}.edge.architecture{stroke-dasharray:5 5;opacity:.45}.edge.recorded{stroke:var(--c-315e62,#315e62);stroke-width:1.7}.layer{fill:var(--c-62707b,#62707b);font-size:11px;letter-spacing:.05em}.inspector{display:none;width:58%;min-width:440px;border-left:1px solid var(--c-c7d5d4,#c7d5d4);background:var(--c-f5f6f4,#f5f6f4);flex-direction:column}.inspector.open{display:flex}.inspector-bar{display:flex;gap:14px;align-items:center;justify-content:space-between;padding:10px 16px;background:#fff;border-bottom:1px solid var(--line);font-size:12px}.inspector iframe{width:100%;flex:1;border:0;min-height:400px}.fallback{padding:24px;overflow:auto}.fallback h2{font-size:20px}.badge{display:inline-block;font-size:12px;padding:5px 8px;border:1px solid var(--line);border-radius:5px;margin:5px}.legend{flex-shrink:0;display:flex;gap:16px;flex-wrap:wrap;padding:12px 26px;background:#fff;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px}.summary{font-size:11px;color:var(--muted);padding:8px 16px;background:#fff;border-top:1px solid var(--line)}.selected-detail .catalog{display:none}#caseNote{max-width:440px;overflow-wrap:anywhere}#error{color:var(--c-9a3324,#9a3324)}.emptygraph{text-align:center;color:var(--muted);padding:50px 20px}.hidden{display:none!important}@media(max-width:1000px){.catalog{width:180px}.inspector{width:65%;min-width:380px}.toolbar .hint{display:none}}@media(max-width:700px){.top{padding:16px}.topline{align-items:flex-start}.topline>a{font-size:12px}.controls{gap:8px}.controls label{flex-wrap:wrap;flex:1;min-width:140px}.controls select{min-width:0;width:100%}.notice{padding:10px 16px}.catalog{width:155px}.shell{min-height:200px}.inspector.open{position:fixed;inset:0;width:100%;min-width:0;z-index:10}.legend{padding:12px 16px}.toolbar{padding:8px}.toolbar button{padding:6px}.subtitle{margin-bottom:12px}h1{font-size:23px}}
</style></head><body>
<header class="top"><div class="topline"><div><div class="eyebrow">Credit analysis · Evidence to decision</div><h1>Pipeline Viewer <span style="color:#719596">V2</span></h1></div><a href="/credit-memos">Credit memos &amp; review ↗</a></div><p class="subtitle">Pipeline Explorer · Inspect recorded analysis, trace evidence and review governance.</p>
<div class="controls"><label>Case<select id="caseSelect"><option value="">Choose a recorded case</option>{% for c in cases %}<option value="{{ c.case_id }}">{{ c.label }}</option>{% endfor %}</select></label><label>Run<select id="runSelect" disabled><option value="">Select a case first</option></select></label><button id="btnManifest">Manifest JSON ↗</button><span id="caseNote" class="subtitle"></span></div></header>
<div class="notice" id="lineage">Read-only inspection. Dashed connections describe architecture; solid connections identify recorded artifact references.</div><div id="error" role="alert"></div>
<div class="shell" id="shell"><aside class="catalog"><input id="nodeSearch" placeholder="Find a stage…" aria-label="Find a stage"><h2>STAGES &amp; ARTIFACTS</h2><div id="nodeList"></div></aside><div class="graph-area"><div class="toolbar"><button id="btnFit">Fit graph</button><button id="btnZoomIn" aria-label="Zoom in">＋</button><button id="btnZoomOut" aria-label="Zoom out">−</button><button id="btnArchitecture" aria-pressed="true">Architecture on</button><span class="hint">Scroll to zoom · Drag to pan · Select a stage</span></div><div class="graphwrap"><svg id="graph" aria-label="Left to right pipeline graph" viewBox="0 0 2900 1000"><defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#96aca7"/></marker></defs><g id="viewport"></g></svg></div><div class="summary" id="statusSummary">Choose a case or explore the architecture.</div></div><aside id="inspector" class="inspector" aria-label="Selected stage report"><div class="inspector-bar"><strong id="stageTitle">Stage report</strong><a id="openReport" target="_blank" rel="noopener">Open full report ↗</a><button id="closeReport" aria-label="Close report">Close ×</button></div><iframe id="reportFrame" title="Selected stage report"></iframe><div id="stageFallback" class="fallback hidden"></div></aside></div>
<div class="legend" id="legend"></div>
<script>
const categories={deterministic:['Deterministic','#527789'],ai:['AI agent','#668b78'],validator:['Validator','#b39452'],orchestration:['Orchestration / challenge','#8c7b9e'],human:['Human review','#b37e63'],artifact:['Persisted artifact','#75868c']};
const notes={{ cases|tojson }};
const $=id=>document.getElementById(id),svg=$('graph'),viewport=$('viewport');
let graph=null,currentCase='',currentRun='',view={x:0,y:0,k:1},architecture=true,requestId=0,selectedId=null;
const NS='http://www.w3.org/2000/svg',W=215,H=80,DX=255,DY=100;
function el(tag,attrs={},label){const n=document.createElementNS(NS,tag);Object.entries(attrs).forEach(([k,v])=>n.setAttribute(k,v));if(label!==undefined)n.textContent=label;return n;}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
$('legend').innerHTML=Object.values(categories).map(([name,color])=>`<span><i style="background:${color}"></i>${name}</span>`).join('')+'<span>Dashed: architecture only · Solid: recorded reference</span>';
function apply(){viewport.setAttribute('transform',`translate(${view.x},${view.y}) scale(${view.k})`);}
function fit(){if(!graph)return;const maxLayer=Math.max(...graph.nodes.map(n=>n.layer)),counts={};graph.nodes.forEach(n=>counts[n.layer]=(counts[n.layer]||0)+1);svg.setAttribute('viewBox',`0 0 ${(maxLayer+1)*DX+40} ${Math.max(600,Math.max(...Object.values(counts))*DY+100)}`);view={x:0,y:0,k:1};apply();}
function draw(g){graph=g;viewport.replaceChildren();const counts={},positions={};g.nodes.forEach(n=>{positions[n.id]={x:25+n.layer*DX,y:65+(counts[n.layer]||0)*DY};counts[n.layer]=(counts[n.layer]||0)+1;});Object.entries(g.layers).forEach(([i,label])=>viewport.append(el('text',{x:25+Number(i)*DX,y:28,class:'layer'},label)));
g.edges.forEach(e=>{const a=positions[e.source],b=positions[e.target];if(!a||!b)return;const x=a.x+W,y=a.y+H/2,x2=b.x,y2=b.y+H/2,m=(x+x2)/2,p=el('path',{d:`M${x},${y} C${m},${y} ${m},${y2} ${x2},${y2}`,class:'edge '+e.kind});p.append(el('title',{},e.reason));viewport.append(p);});
g.nodes.forEach(n=>{const p=positions[n.id],color=(categories[n.category]||categories.artifact)[1],group=el('g',{class:'node'+(n.illustration?' illustration':''),transform:`translate(${p.x},${p.y})`,tabindex:0,role:'button','aria-label':n.label});group.dataset.id=n.id;group.append(el('rect',{width:W,height:H,rx:7,class:'box'}));group.append(el('rect',{width:4,height:H-16,x:0,y:8,fill:color}));const words=n.label.split(' '),lines=[''];words.forEach(w=>{if((lines[lines.length-1]+' '+w).length>30)lines.push('');lines[lines.length-1]+=(lines[lines.length-1]?' ':'')+w;});lines.slice(0,2).forEach((line,i)=>group.append(el('text',{x:12,y:21+i*15,class:'label'},line)));group.append(el('text',{x:12,y:55,class:'meta'},n.illustration?'Architecture only · no recorded output':`Execution: ${n.states.execution}`));group.append(el('text',{x:12,y:69,class:'meta'},n.illustration?(categories[n.category]||categories.artifact)[0]:`Validation: ${n.states.validation} · Review: ${n.states.governance}`));group.append(el('title',{},n.label+'\n'+(n.status_reason||'')+'\n'+(n.run_id||'')));group.addEventListener('click',()=>selectNode(n));group.addEventListener('keydown',e=>{if(['Enter',' '].includes(e.key)){e.preventDefault();selectNode(n);}});viewport.append(group);});
$('statusSummary').textContent=g.selection_required?'Select an exact run to bind recorded nodes.':`${g.nodes.filter(n=>!n.illustration).length} recorded artifacts · ${g.nodes.filter(n=>n.illustration).length} architecture nodes · ${g.run_id||'Architecture view'}`;renderList();toggleEdges();fit();}
function renderList(){if(!graph)return;const query=$('nodeSearch').value.toLowerCase();$('nodeList').replaceChildren();graph.nodes.filter(n=>(n.label+' '+(n.group||'')+' '+(n.artifact_id||'')).toLowerCase().includes(query)).forEach(n=>{const b=document.createElement('button');b.className='node-link';b.setAttribute('aria-current',n.id===selectedId);b.innerHTML=esc(n.label)+`<small>${esc(n.illustration?'Architecture only':n.states.execution+' · '+n.states.validation+' · '+n.states.governance.replaceAll('_',' '))}</small>`;b.onclick=()=>selectNode(n);$('nodeList').append(b);});}
function selectNode(n){selectedId=n.id;document.querySelectorAll('.node').forEach(e=>e.classList.toggle('selected',e.dataset.id===n.id));renderList();$('shell').classList.add('selected-detail');$('inspector').classList.add('open');$('stageTitle').textContent=n.label;const frame=$('reportFrame'),fallback=$('stageFallback');if(!n.artifact_id){frame.classList.add('hidden');frame.src='about:blank';fallback.classList.remove('hidden');fallback.innerHTML=`<div class="eyebrow">Architecture reference</div><h2>${esc(n.label)}</h2><p>No recorded output is bound to this stage in the selected run.</p><p>Execution, validation and governance are unavailable. Architecture connections do not establish an execution result.</p><p>${esc(n.status_reason||'')}</p>`;$('openReport').classList.add('hidden');return;}
frame.classList.remove('hidden');fallback.classList.add('hidden');const base=`/pipeline/${encodeURIComponent(currentCase)}/node/${encodeURIComponent(n.artifact_id)}/report.html`;const pin=(n.expected_hash?'&expected_hash='+encodeURIComponent(n.expected_hash):'')+(n.source_file_sha256?'&expected_source_hash='+encodeURIComponent(n.source_file_sha256):'');frame.src=base+'?embedded=true'+pin;$('openReport').href=base+'?embedded=false'+pin;$('openReport').classList.remove('hidden');const url=new URL(location.href);url.searchParams.set('node',n.id);history.replaceState(null,'',url);}
function closeReport(){selectedId=null;$('inspector').classList.remove('open');$('shell').classList.remove('selected-detail');$('reportFrame').src='about:blank';document.querySelectorAll('.node').forEach(n=>n.classList.remove('selected'));renderList();}
async function loadCase(caseId,run=''){const id=++requestId;currentCase=caseId;currentRun=run;closeReport();$('error').textContent='';try{const response=await fetch(`/pipeline/${encodeURIComponent(caseId||'architecture')}/graph.json`+(run?'?run_id='+encodeURIComponent(run):''));if(!response.ok)throw Error((await response.json()).detail);const g=await response.json();if(id!==requestId)return;const select=$('runSelect');select.replaceChildren();if(g.runs.length!==1){select.add(new Option('Choose an exact recorded run',''));}g.runs.forEach(r=>select.add(new Option(r,r)));select.disabled=!g.runs.length;select.value=g.run_id||'';currentRun=g.run_id||'';$('caseNote').textContent=(notes.find(c=>c.case_id===caseId)||{}).note||'';$('lineage').textContent=g.lineage_notice;draw(g);const url=new URL(location.href);if(caseId)url.searchParams.set('case',caseId);else url.searchParams.delete('case');if(currentRun)url.searchParams.set('run',currentRun);else url.searchParams.delete('run');history.replaceState(null,'',url);}catch(e){$('error').textContent=e.message;}}
function toggleEdges(){document.querySelectorAll('.edge.architecture').forEach(e=>e.style.display=architecture?'':'none');$('btnArchitecture').textContent='Architecture '+(architecture?'on':'off');$('btnArchitecture').setAttribute('aria-pressed',architecture);}
$('caseSelect').onchange=()=>loadCase($('caseSelect').value);$('runSelect').onchange=()=>loadCase(currentCase,$('runSelect').value);$('nodeSearch').oninput=renderList;$('closeReport').onclick=closeReport;$('btnFit').onclick=fit;$('btnArchitecture').onclick=()=>{architecture=!architecture;toggleEdges();};$('btnManifest').onclick=()=>{if(currentCase)window.open(`/pipeline/${encodeURIComponent(currentCase)}/manifest.json`,'_blank','noopener');};
function point(e){const p=new DOMPoint(e.clientX,e.clientY);return p.matrixTransform(svg.getScreenCTM().inverse());}
function zoom(f,p){const k=Math.max(.25,Math.min(12,view.k*f));view.x=p.x-(p.x-view.x)*k/view.k;view.y=p.y-(p.y-view.y)*k/view.k;view.k=k;apply();}
svg.addEventListener('wheel',e=>{e.preventDefault();zoom(e.deltaY<0?1.15:1/1.15,point(e));},{passive:false});let drag=null;
svg.addEventListener('pointerdown',e=>{if(e.target.closest('.node'))return;drag={id:e.pointerId,p:point(e)};svg.setPointerCapture(e.pointerId);svg.classList.add('panning');});svg.addEventListener('pointermove',e=>{if(!drag||drag.id!==e.pointerId)return;const p=point(e);view.x+=p.x-drag.p.x;view.y+=p.y-drag.p.y;drag.p=p;apply();});function stop(){drag=null;svg.classList.remove('panning');}svg.addEventListener('pointerup',stop);svg.addEventListener('pointercancel',stop);
const center=()=>({x:svg.viewBox.baseVal.width/2,y:svg.viewBox.baseVal.height/2});$('btnZoomIn').onclick=()=>zoom(1.3,center());$('btnZoomOut').onclick=()=>zoom(1/1.3,center());document.addEventListener('keydown',e=>{if(e.key==='Escape')closeReport();});
const initial=new URLSearchParams(location.search);if(initial.get('case'))$('caseSelect').value=initial.get('case');loadCase(initial.get('case')||'',initial.get('run')||'').then(()=>{const node=graph?.nodes.find(n=>n.id===initial.get('node'));if(node)selectNode(node);});
</script></body></html>
