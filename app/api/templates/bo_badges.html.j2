{# Shared statement-type and credit-direction badges for all BO sections. #}
{% macro finding_icon(kind) %}<svg class="bo-badge-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{% if kind == 'fact' %}<path d="M11.5 2.5H5a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7l-4.5-4.5Z"/><path d="M11 2.5V7h5M6.5 11l2 2 4-4"/>{% elif kind == 'inference' %}<circle cx="4" cy="5" r="2"/><circle cx="16" cy="5" r="2"/><circle cx="10" cy="15" r="2.5"/><path d="m5 7 3.5 5.5M15 7l-3.5 5.5M6 5h8"/>{% elif kind == 'assumption' %}<path d="m10 2 8 8-8 8-8-8 8-8Z"/><path d="M8 7.5a2 2 0 1 1 3.1 1.7c-.8.4-1.1.8-1.1 1.8M10 14h.01"/>{% elif kind == 'calculated_fact' %}<rect x="4" y="2" width="12" height="16" rx="2"/><path d="M7 6h6M7 10h.01M10 10h.01M13 10h.01M7 14h.01M10 14h.01M13 14h.01"/>{% else %}<path d="M4 3h12a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H8l-5 3V4a1 1 0 0 1 1-1Z"/><path d="M6 7h8M6 10h5"/>{% endif %}</svg>{% endmacro %}
{% macro classification_badge(value) %}{% if value %}<span class="bo-finding-badge bo-badge-type bo-type-{{ value.kind }}">{{ finding_icon(value.kind) }}<span>{{ value.label }}</span></span>{% endif %}{% endmacro %}
{% macro direction_badge(label, classification=none) -%}
<div class="bo-finding-badges" role="group" aria-label="Credit Direction"><span class="bo-finding-badge bo-badge-direction bo-direction-{{ label|lower }}"><span class="bo-direction-sign" aria-hidden="true">{% if label == 'Positive' %}+{% elif label == 'Negative' %}−{% elif label == 'Mixed' %}±{% else %}—{% endif %}</span><span>{{ label }}</span></span>{% if classification %}{{ classification_badge(classification) }}{% endif %}</div>
{%- endmacro %}
