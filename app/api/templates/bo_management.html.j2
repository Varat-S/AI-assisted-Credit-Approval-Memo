{% if pdf %}{% include 'bo_management_pdf.html.j2' %}{% else %}{# Same read-only projection for interactive and print views. #}
{% set m = bo4.management %}
{% from 'bo_evidence.html.j2' import evidence with context %}
{% macro references(item) %}{% if item.evidence %}{{ evidence(item.evidence) }}{% endif %}{% endmacro %}
{% macro finding(item) %}
<div class="memo-claim bo-management-finding" data-review-status="{{ item.review_status }}" data-direction="{{ item.direction or 'unassessed' }}">
  <p class="bo-management-classification">{{ item.direction_label }} · {{ item.review_status|title }}</p>
  <p>{{ item.text }}</p>
  {{ references(item) }}
</div>
{% endmacro %}

{% if m %}
<div class="memo-claim bo-management-overall">
  <h3>Overall assessment</h3>
  <p class="bo-management-classification">{{ m.overall_assessment.wording_label }} · {{ m.overall_assessment.status|title }} · Recorded outcome: {{ m.overall_assessment.outcome|replace('_', ' ')|title }}</p>
  <p class="bo-management-assessment-text">{{ m.overall_assessment.text }}</p>
  {% if m.qualifications %}<div class="bo-management-qualifications"><h4>Material qualifications</h4><ul>{% for qualification in m.qualifications %}<li class="qualification">{{ qualification.text }}</li>{% endfor %}</ul></div>{% endif %}
</div>

{% if pdf %}
<div class="bo-management-print"><h3>Key credit considerations</h3>
  {% for group in m.finding_groups if group.print_findings %}
  <section class="bo-management-direction-group" data-finding-group="{{ group.id }}"><h4>{{ group.title }}</h4>
    {% for item in group.print_findings %}{{ finding(item) }}{% endfor %}
    {% if group.omitted_count %}<p class="technical-note">{{ group.omitted_count }} additional {{ group.title|lower }} remain available in this run's complete supporting evidence and Audit &amp; Review, with their qualifications.</p>{% endif %}
  </section>
  {% else %}<p class="memo-empty">No eligible reviewed management findings are available.</p>{% endfor %}
</div>
{% else %}
<h3>Credit-Relevant Findings</h3>
<div class="bo-management-grid">
{% for category in m.categories if category.findings %}
  <section class="bo-management-card" data-management-category="{{ category.id }}">
    <h3>{{ category.title }}</h3>
    {% for group in m.finding_groups %}{% set members = category.findings|selectattr('group_id', 'equalto', group.id)|list %}{% if members %}
    <div data-finding-group="{{ group.id }}"><h4>{{ group.title }}</h4>{% for item in members %}{{ finding(item) }}{% endfor %}</div>
    {% endif %}{% endfor %}
  </section>
{% else %}<p class="memo-empty">No reviewed findings can be reliably assigned to a management category.</p>{% endfor %}
</div>
{% if m.uncategorized %}
<details class="bo-management-other" data-run-id="{{ bo4.memo.identity.analysis_run_id }}"{% if m.uncategorized_concerns %} open{% endif %}>
  <summary>Other Reviewed Observations ({{ m.uncategorized|length }}){% if m.uncategorized_concerns %} · Includes reviewed credit concerns{% endif %}</summary>
  {% for item in m.uncategorized %}{{ finding(item) }}{% endfor %}
</details>
{% endif %}
{% if m.information_gaps %}<div class="bo-management-gaps"><h3>Information Gaps</h3>{% for item in m.information_gaps %}{{ finding(item) }}{% endfor %}</div>{% endif %}
{% endif %}

{% if m.assessment_gaps or m.coverage_missing %}
<div class="bo-management-assessment-gaps"><h3>Areas Requiring Further Assessment</h3>
  {% if m.assessment_gaps %}<ul>{% for category in m.assessment_gaps %}<li>{{ category.title }} — {{ category.status|replace('_', ' ')|capitalize }}.</li>{% endfor %}</ul>{% endif %}
  {% if m.coverage_missing %}<p class="qualification">Missing management coverage: {{ m.coverage_missing|join(', ') }}</p>{% endif %}
</div>
{% endif %}

{% if m.methodology_notices %}<aside class="bo-management-methodology"><h4>Methodology / demonstration notice</h4>{% for text in m.methodology_notices %}<p class="technical-note">{{ text }}</p>{% endfor %}</aside>{% endif %}

{% if not pdf %}
<details class="bo-management-support" data-run-id="{{ bo4.memo.identity.analysis_run_id }}">
  <summary>Executive Profiles &amp; Supporting Evidence</summary>
  {% if m.overall_assessment.original_text %}<h3>Original model assessment</h3><p>{{ m.overall_assessment.original_text }}</p>{% endif %}
  <h3>Executive profiles</h3>
  {% for profile in m.executive_profiles %}<div class="memo-claim">
    <h4>{{ profile.name }} · {{ profile.position }}</h4>
    <p>Appointment: {{ profile.appointment_date or 'Not recorded' }}{% if profile.appointment_precision %} ({{ profile.appointment_precision }}){% endif %}</p>
    {% if profile.tenure %}<p>Recorded tenure: {{ profile.tenure.minimum_days }} to {{ profile.tenure.maximum_days }} days as of {{ profile.tenure.as_of }}</p>{% endif %}
    {% if profile.succession %}<p>Succession: {{ profile.succession|replace('_',' ')|capitalize }}</p>{% endif %}
    {% for role in profile.prior_internal_roles %}<p>{{ role.position }} · {{ role.start_date or 'Not recorded' }} to {{ role.end_date or 'Not recorded' }}</p>{% endfor %}
    {{ references(profile) }}
  </div>{% endfor %}
  <h3>Original reviewed observations</h3>
  {% for observation in m.reviewed_observations %}<div class="memo-claim"><p>{{ observation.text }}</p>
    <p class="technical-note">Recorded direction: {{ observation.direction or 'Unassessed' }} · Review: {{ observation.review_outcome|title }}</p>
    {% if observation.review_outcome == 'qualified' %}<p class="qualification">{{ observation.review_reason }}</p>{% endif %}
    {% for limitation in observation.uncertainties %}<p class="qualification">{{ limitation }}</p>{% endfor %}
    {{ references(observation) }}
  </div>{% endfor %}
  {% if m.recorded_limitations %}<h3>Original qualifications and limitations</h3>{% for text in m.recorded_limitations %}<p class="qualification">{{ text }}</p>{% endfor %}{% endif %}
  {% if m.technical_notes %}<h3>Processing and detailed review records</h3>{% for text in m.technical_notes %}<p class="technical-note">{{ text }}</p>{% endfor %}{% endif %}
</details>
{% endif %}
{% else %}<p class="memo-empty">Reviewed management analysis is not available for this run.</p>{% endif %}{% endif %}
