{% if pdf %}{% include 'bo_management_pdf.html.j2' %}{% else %}{# Same read-only projection for interactive and print views. #}
{% set m = bo4.management %}
{% from 'bo_badges.html.j2' import direction_badge %}
{% from 'bo_management_points.html.j2' import management_points %}
{% from 'bo_evidence.html.j2' import evidence with context %}
{% macro references(item) %}{% if item.evidence %}{{ evidence(item.evidence) }}{% endif %}{% endmacro %}
{% macro finding(item) %}
<div class="memo-claim bo-management-finding" data-review-status="{{ item.review_status }}" data-direction="{{ item.direction or 'unassessed' }}">
  {{ direction_badge(item.direction_label) }}
  {{ management_points(item) }}
  {{ references(item) }}
</div>
{% endmacro %}

{% if m %}
<div class="memo-claim bo-management-overall">
  <h3>Overall assessment</h3>
  {{ direction_badge(m.overall_assessment.outcome|replace('_', ' ')|title, m.overall_assessment.classification) }}
  <p class="bo-management-assessment-text">{{ m.overall_assessment.text }}</p>
</div>

{% if pdf %}
<div class="bo-management-print"><h3>Key credit considerations</h3>
  {% for group in m.finding_groups if group.print_findings %}
  <section class="bo-management-direction-group" data-finding-group="{{ group.id }}">
    {% for item in group.print_findings %}{{ finding(item) }}{% endfor %}
    {% if group.omitted_count %}<p class="technical-note">{{ group.omitted_count }} additional {{ group.title|lower }} remain available in this run's complete supporting evidence and Audit &amp; Review, with their qualifications.</p>{% endif %}
  </section>
  {% else %}<p class="memo-empty">No eligible reviewed management findings are available.</p>{% endfor %}
</div>
{% else %}
<h3>Credit-Relevant Findings</h3>
<div class="bo-management-grid">
{% for category in m.categories if category.findings %}
  <section class="bo-management-card" data-management-category="{{ category.id }}">
    <h3>{{ category.title }}</h3>
    {% for group in m.finding_groups %}{% set members = category.findings|selectattr('group_id', 'equalto', group.id)|list %}{% if members %}
    <div data-finding-group="{{ group.id }}">{% for item in members %}{{ finding(item) }}{% endfor %}</div>
    {% endif %}{% endfor %}
  </section>
{% else %}<p class="memo-empty">No reviewed findings can be reliably assigned to a management category.</p>{% endfor %}
</div>
{% if m.uncategorized %}
<details class="bo-management-other" data-run-id="{{ bo4.memo.identity.analysis_run_id }}"{% if m.uncategorized_concerns %} open{% endif %}>
  <summary>Other Reviewed Observations ({{ m.uncategorized|length }}){% if m.uncategorized_concerns %} · Includes reviewed credit concerns{% endif %}</summary>
  {% for item in m.uncategorized %}{{ finding(item) }}{% endfor %}
</details>
{% endif %}
{% if m.information_gaps %}<div class="bo-management-gaps"><h3>Information Gaps</h3>{% for item in m.information_gaps %}{{ finding(item) }}{% endfor %}</div>{% endif %}
{% endif %}


{% else %}<p class="memo-empty">Reviewed management analysis is not available for this run.</p>{% endif %}{% endif %}
