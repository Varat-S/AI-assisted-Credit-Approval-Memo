{% include 'browser_style.html.j2' %}
<style>
  :root{color:var(--c-192b3b);background:var(--c-f5f6f4);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  body{max-width:1120px;padding:42px 28px 30px;line-height:1.55}h1{font-family:Georgia,serif;font-size:2.8rem;font-weight:500;letter-spacing:-.03em;margin:14px 0}h2{font-size:1.18rem}a{color:var(--c-1e5d60)}a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid var(--c-488c8c);outline-offset:4px}
  .eyebrow{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--c-517273);font-weight:700}.workspace-header{background:transparent;border:0;padding:20px 0 32px;margin:0}.workspace-header p{max-width:650px;color:var(--c-62707b)}.workspace-cards{display:grid;grid-template-columns:1fr 1fr;gap:24px;border:0;padding:0;background:transparent;margin:0}.workspace-card{position:relative;display:block;min-height:245px;padding:32px;border:1px solid var(--c-d8dfdf);border-radius:12px;background:var(--c-ffffff);text-decoration:none;color:var(--c-192b3b);transition:border-color .15s,box-shadow .15s}.workspace-card:hover{color:var(--c-192b3b);border-color:var(--c-719596);box-shadow:0 8px 24px var(--c-1d39460a)}.workspace-card h2{font-size:1.45rem;margin:24px 0 10px}.workspace-card p{max-width:330px;color:var(--c-62707b);margin:0}.card-icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:var(--c-edf4f2);color:var(--c-285d5e)}.card-arrow{position:absolute;right:30px;top:38px;color:var(--c-497578)}.workspace-footer{margin-top:34px;font-size:.8rem;color:var(--c-74808a)}
