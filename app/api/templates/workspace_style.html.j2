ce-panel dt{font-size:.76rem;color:var(--c-718087);margin-top:17px}.evidence-panel dd{font-size:.88rem;margin-top:4px;overflow-wrap:anywhere}.evidence-tag{display:inline-block;font-size:.72rem;padding:3px 9px;border-radius:20px;color:var(--c-386963);background:var(--c-edf5f1)}.readiness{margin-top:24px;padding-top:18px;border-top:1px solid var(--c-e5eaea);font-size:.8rem;color:var(--c-687780)}.readiness strong{display:block;color:var(--c-395c5b);margin-bottom:4px}.setup-errors{margin-bottom:20px;padding:15px 18px;border:1px solid var(--c-e1cbb7);background:var(--c-fcf8f3);border-radius:8px;font-size:.9rem}.setup-errors ul{margin:6px 0;padding-left:20px}.setup-checked{padding:12px 16px;background:var(--c-edf5f1);border:1px solid var(--c-c9dcd3);border-radius:8px;margin-bottom:20px;font-size:.88rem}.placeholder{padding:32px;background:var(--c-ffffff);border:1px solid var(--c-dce2e1);border-radius:12px}.placeholder p{color:var(--c-62707b);max-width:620px}
