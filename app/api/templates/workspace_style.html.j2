{% include 'browser_style.html.j2' %}
<style>
  :root{color:#192b3b;background:#f5f6f4;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  body{max-width:1120px;padding:42px 28px 30px;line-height:1.55}h1{font-family:Georgia,serif;font-size:2.8rem;font-weight:500;letter-spacing:-.03em;margin:14px 0}h2{font-size:1.18rem}a{color:#1e5d60}a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #488c8c;outline-offset:4px}
  .eyebrow{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:#517273;font-weight:700}.workspace-header{background:transparent;border:0;padding:20px 0 32px;margin:0}.workspace-header p{max-width:650px;color:#62707b}.workspace-cards{display:grid;grid-template-columns:1fr 1fr;gap:24px;border:0;padding:0;background:transparent;margin:0}.workspace-card{position:relative;display:block;min-height:245px;padding:32px;border:1px solid #d8dfdf;border-radius:12px;background:white;text-decoration:none;color:#192b3b;transition:border-color .15s,box-shadow .15s}.workspace-card:hover{color:#192b3b;border-color:#719596;box-shadow:0 8px 24px #1d39460a}.workspace-card h2{font-size:1.45rem;margin:24px 0 10px}.workspace-card p{max-width:330px;color:#62707b;margin:0}.card-icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:#edf4f2;color:#285d5e}.card-arrow{position:absolute;right:30px;top:38px;color:#497578}.workspace-footer{margin-top:34px;font-size:.8rem;color:#74808a}
  .workspace-nav{display:flex;align-items:center;justify-content:space-between;padding:0 0 22px;border:0;border-bottom:1px solid #dce2e1;border-radius:0;background:transparent;margin-bottom:24px;gap:16px}.workspace-nav .brand{color:#344955;text-decoration:none;font-size:.8rem;letter-spacing:.08em;font-weight:700}.workspace-nav ul{margin:0;gap:22px}.workspace-nav a{text-decoration:none;font-size:.9rem}.workspace-nav a[aria-current=page]{color:#183f43;font-weight:700;border-bottom:2px solid #397477;padding-bottom:7px}
  .setup-header{padding:0;border:0;background:transparent;margin-bottom:28px}.setup-header h1{font-size:2.3rem;margin:8px 0 10px}.setup-header>p{color:#62707b;margin:0}.stepper{display:flex;list-style:none;padding:18px 22px;margin:26px 0 0;background:#fff;border:1px solid #dce2e1;border-radius:10px;gap:36px}.stepper li{display:flex;align-items:center;gap:10px;color:#849097}.step-number{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;border:1px solid #d9dfdf;font-size:.8rem}.stepper [aria-current=step]{color:#254c50;font-weight:700}.stepper [aria-current=step] .step-number{background:#284f53;color:white;border-color:#284f53}
  .setup-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(270px,1fr);gap:24px;align-items:start}.setup-panel,.evidence-panel{background:white;border:1px solid #dce2e1;border-radius:12px;padding:28px}.setup-panel h2,.evidence-panel h2{margin:0 0 20px}.setup-panel fieldset{margin:24px 0 0;padding:0;border:0}.setup-panel legend{padding:0;font-size:.94rem;margin-bottom:10px}.setup-panel select{margin-bottom:0;padding:12px}.choice{display:flex;align-items:flex-start;gap:12px;padding:14px;border:1px solid #dce2e1;border-radius:8px;margin:0 0 10px;font-weight:400;cursor:pointer}.choice:has(input:checked){border-color:#518587;background:#f0f6f4}.choice input{width:17px;height:17px;padding:0;flex-shrink:0;margin:3px 0 0;accent-color:#315e62}.choice strong{display:block;font-size:.91rem}.choice small{display:block;margin-top:3px;line-height:1.5;font-size:.8rem}.setup-panel details{border-top:1px solid #e7ebeb;padding-top:18px;margin-top:22px}.setup-panel details label{margin-top:15px;font-size:.88rem}.setup-panel .hint{font-size:.8rem;color:#687780;margin:8px 0}.mode-note{font-size:.82rem;border-left:3px solid #c69a44;background:#fbf7ed;padding:12px 14px;margin:12px 0}.setup-actions{display:flex;justify-content:space-between;gap:16px;align-items:center;border-top:1px solid #e7ebeb;margin-top:24px;padding-top:22px}.primary-button{background:#294f53;border-color:#294f53;color:white;border-radius:7px;padding:12px 20px}.primary-button:disabled{background:#dce4e3;color:#6a7b7d;border-color:#dce4e3;opacity:1}.secondary-button{background:white;border-color:#c7d5d4;color:#315e62;padding:11px 16px}.execution-note{font-size:.8rem;color:#687780;margin:12px 0 0}.evidence-panel .evidence-name{font-family:Georgia,serif;font-size:1.25rem;margin:5px 0 20px}.evidence-panel dl{display:block;margin:0}.evidence-panel dt{font-size:.76rem;color:#718087;margin-top:17px}.evidence-panel dd{font-size:.88rem;margin-top:4px;overflow-wrap:anywhere}.evidence-tag{display:inline-block;font-size:.72rem;padding:3px 9px;border-radius:20px;color:#386963;background:#edf5f1}.readiness{margin-top:24px;padding-top:18px;border-top:1px solid #e5eaea;font-size:.8rem;color:#687780}.readiness strong{display:block;color:#395c5b;margin-bottom:4px}.setup-errors{margin-bottom:20px;padding:15px 18px;border:1px solid #e1cbb7;background:#fcf8f3;border-radius:8px;font-size:.9rem}.setup-errors ul{margin:6px 0;padding-left:20px}.setup-checked{padding:12px 16px;background:#edf5f1;border:1px solid #c9dcd3;border-radius:8px;margin-bottom:20px;font-size:.88rem}.placeholder{padding:32px;background:white;border:1px solid #dce2e1;border-radius:12px}.placeholder p{color:#62707b;max-width:620px}
  @media(max-width:800px){.setup-layout{grid-template-columns:1fr}.workspace-nav{align-items:flex-start}.workspace-nav .brand{max-width:150px}.workspace-cards{gap:16px}.workspace-card{padding:24px}.card-arrow{right:22px;top:30px}}
  @media(max-width:560px){body{padding:22px 16px}.workspace-header h1{font-size:2.1rem}.workspace-cards{grid-template-columns:1fr}.workspace-card{min-height:205px}.setup-panel,.evidence-panel{padding:22px}.stepper{gap:18px;padding:14px;font-size:.84rem}.step-number{width:24px;height:24px}.workspace-nav ul{gap:14px}.setup-actions{flex-wrap:wrap}.workspace-nav .brand{font-size:.7rem}}
  @media(prefers-reduced-motion:reduce){.workspace-card{transition:none}}
</style>
