  @media(max-width:800px){.setup-layout{grid-template-columns:1fr}.workspace-nav{align-items:flex-start}.workspace-nav .brand{max-width:150px}.workspace-cards{gap:16px}.workspace-card{padding:24px}.card-arrow{right:22px;top:30px}}
