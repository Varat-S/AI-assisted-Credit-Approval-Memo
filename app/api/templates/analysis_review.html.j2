<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Credit Memo · {{ job.metadata.company or job.folder if pdf else 'Review' }}</title>{% include 'workspace_style.html.j2' %}{% include 'analysis_memo_style.html.j2' %}{% if view.four_section %}{% include 'bo_four_section_style.html.j2' %}{% endif %}{% if not pdf %}{% include 'memo_typography.html.j2' %}{% endif %}{% if pdf %}{% set footer = (job.metadata.company or job.folder or 'Credit memo')|replace('"','')|replace('\\','')|replace('<','')|replace('>','') %}{% include 'memo_typography.html.j2' %}<style>
{# Paper layout only, kept compact; the type scale comes from memo_typography, shared with the Memo tab.
   !important where the section print stylesheets force page breaks or set their own spacing. #}
@page{size:A4;margin:12mm 12mm 13mm;@bottom-left{content:"{{ footer|safe }} · Credit memo";font:9px "Segoe UI",Inter,Arial,sans-serif;color:#62707b}@bottom-right{content:"Page " counter(page) " of " counter(pages);font:9px "Segoe UI",Inter,Arial,sans-serif;color:#62707b}}
*{-webkit-print-color-adjust:exact;print-color-adjust:exact}
:root,body{background:var(--c-ffffff)}
body{max-width:none;padding:0}
main p,main li,main dt,main dd,main blockquote,main aside{line-height:1.38}
body .analysis-header{margin-bottom:8px;padding-bottom:6px;border:0;border-bottom:2px solid var(--c-294f53);border-radius:0}body .analysis-header h1{margin:0 0 2px}body .analysis-header .eyebrow{margin:0}body .analysis-meta{gap:2px 16px}
body .memo-status{padding:4px 8px;margin:5px 0;border-radius:4px}
.memo-paper{border:0;border-radius:0;padding:0}
.memo-paper h2,.bo-four-section h2{color:var(--c-192b3b);border:0;border-bottom:1px solid var(--c-c7d5d4);padding:0 0 3px!important;margin:14px 0 6px!important;break-after:avoid}.memo-paper h2:first-child{margin-top:2px!important}
.memo-paper h3,.bo-four-section h3{margin:10px 0 4px!important;break-after:avoid}.memo-paper h4,.bo-four-section h4{margin:6px 0 2px!important;break-after:avoid}
.memo-paper p{margin:2px 0 4px!important}.memo-paper ul,.memo-paper ol{margin:2px 0 4px;padding-left:18px}.memo-paper li{margin:1px 0!important}
.memo-paper .notice-warning{padding:4px 8px!important;margin:5px 0!important;break-inside:avoid}
.memo-paper .memo-claim,.memo-paper .bo-management-finding{margin:4px 0 6px!important;padding:0!important}.memo-paper .bo-finding-group,.memo-paper .bo-management-direction-group{margin:4px 0}
.bo-print-schedules,.bo-memo-section,.bo-management-credit-page,.bo-management-details-page{break-before:auto!important;break-after:auto!important}
.memo-table-wrap{overflow:visible;margin:2px 0 6px}.memo-paper .memo-table{width:100%;margin:2px 0}.memo-paper .bo-debt-table,.memo-paper .memo-table{table-layout:auto;min-width:0}
.memo-paper .memo-table th,.memo-paper .memo-table td,.memo-paper .bo-management-executive-table th,.memo-paper .bo-management-executive-table td{padding:3px 5px!important;min-width:0;overflow-wrap:normal;word-break:normal;hyphens:auto;vertical-align:top}.memo-paper .memo-table thead th{font-weight:700;color:var(--c-315e62);border-bottom:1.5px solid var(--c-94aaa8)}
.memo-paper .bo-priority{display:grid;grid-template-columns:38% 1fr;gap:2px 12px;margin:2px 0 6px}.memo-paper .bo-priority dt,.memo-paper .bo-priority dd{margin:0!important}
.memo-claim,.memo-scores>div,.memo-table tr,.source-list li,.bo-finding-point{break-inside:avoid}
.memo-columns{grid-template-columns:1fr 1fr;gap:18px}.memo-scores{gap:8px;margin:6px 0}.memo-scores>div{padding:6px 10px}
.bo-print-diagram{margin:0 auto!important}.bo-print-diagram>svg{max-height:72mm;overflow:hidden}.memo-paper .bo-debt-summary{margin-top:8px!important}
.memo-paper .bo-snapshot-fallback{padding:6px 10px;margin:6px 0}.memo-paper .bo-snapshot-fallback h4{margin:0 0 2px!important}.memo-paper .bo-snapshot-fallback p{margin:0!important}
.memo-paper .bo-management-assessment-gaps{padding:4px 8px!important;margin:6px 0!important}.memo-paper .bo-management-inventory-note{margin-top:6px!important}
.record-id{margin:6px 0 0}
.bo-competitive-positioning .bo-finding-group{margin-top:6px!important}
.bo-competitive-positioning .memo-claim[data-claim-id]{padding-bottom:5px!important;margin:4px 0 6px!important}
.bo-competitive-positioning .memo-claim>h4{display:inline-block;margin:0 8px 0 0!important;vertical-align:middle}
.bo-competitive-positioning .bo-finding-badges{display:inline-flex;gap:4px;margin:0!important;vertical-align:middle}
.bo-competitive-positioning .bo-finding-badge{padding:0 5px;gap:3px;line-height:1.5}.bo-competitive-positioning .bo-badge-icon{width:11px;height:11px}
.bo-competitive-positioning .bo-finding-points{gap:3px!important;margin:4px 0 0!important}
.bo-competitive-positioning .bo-finding-point{grid-template-columns:104px minmax(0,1fr)!important;gap:10px!important;padding:4px 8px!important}
.bo-competitive-positioning .bo-finding-point dt{gap:3px;padding-top:1px;font-size:var(--memo-small)!important}
.memo-paper .bo-competitive-positioning .bo-finding-points dd p{margin:0 0 2px!important}
</style><script>document.documentElement.dataset.theme = 'light';  // the PDF never follows the OS dark-mode setting</script>{% endif %}</head><body>{% set active='memos' %}{% if not pdf %}{% include 'analysis_nav.html.j2' %}{% endif %}{% from 'credit_macros.html.j2' import usd, sc with context %}
{% macro claim(c) %}{% if c %}<div class="memo-claim" id="{{ c.anchor }}">{% if c.title %}<strong>{{ c.title }}</strong>{% endif %}<p>{{ c.text }} {% if not pdf %}{% for source in c.sources %}<a class="source-cite" href="#{{ source.anchor }}" aria-label="Source {{ source.n }}">[{{ source.n }}]</a>{% endfor %}{% endif %}</p>{% if c.uncertainty %}<p class="qualification">{{ c.uncertainty }}</p>{% endif %}{% if c.missing_citations and not pdf %}<p class="qualification">Some recorded evidence references have no corresponding source citation.</p>{% endif %}</div>{% endif %}{% endmacro %}
{% set analysis_period = view.four_section.memo.identity.as_of_date if view.four_section else view.memo.case.as_of_date if view.memo else none %}{% include 'analysis_tabs.html.j2' %}
<main>
<div class="memo-status">Execution: <strong>{{ job.execution_status|title }}</strong> · Credit memo: <strong>{{ view.governance }}</strong></div>
{% if not pdf and job.execution_status == 'completed' %}<div class="memo-actions"><a class="memo-button primary" href="/analysis/{{ job.job_id|urlencode }}/memo.pdf" download>Download PDF</a></div>{% endif %}

<article class="memo-paper" aria-label="Selected run credit memo">{% if not job.fo_only %}{% if view.four_section %}{% set bo4 = view.four_section %}{% include 'bo_four_section.html.j2' %}{% else %}<h2>Executive Business Credit Assessment</h2>
{% if view.synthesis %}{{ claim(view.synthesis.assessment) }}{% if not pdf %}<p class="technical-note">{{ view.synthesis.origin_notice }}</p>{% endif %}{% else %}<p class="memo-empty">No validated Business Credit Assessment is available for this run.</p><p class="memo-empty">{{ view.reason }}</p>{% endif %}
<div class="memo-columns"><section><h2>Key Credit Strengths</h2>{% for c in (view.synthesis.strengths if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated synthesized strengths available.</p>{% endfor %}</section><section><h2>Key Credit Vulnerabilities</h2>{% for c in (view.synthesis.weaknesses if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated synthesized vulnerabilities available.</p>{% endfor %}</section></div>
<h2>Integrated Business Overview</h2>{% for c in (view.synthesis.integrated if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated integrated conclusions available.</p>{% endfor %}{% if view.bo and not pdf %}<p><a href="/cases/{{ job.case_id }}/bo/runs/{{ view.bo.analysis_run_id }}/memo.html">Open the recorded Business Overview memo</a></p>{% endif %}{% endif %}
{% endif %}{% if not job.bo_only %}<h2>Financial Overview</h2>{% if view.financial %}{% with memo = view.financial, fo_tab = none if pdf else (analysis.tabs|selectattr('key', 'equalto', 'fo')|first).href %}{% include 'fo_memo_section.html.j2' %}{% endwith %}{% if not pdf %}<p><a href="/cases/{{ job.case_id }}/fo/runs/{{ view.fo.run_id }}/memo.html">Open the recorded Financial Overview memo</a></p>{% endif %}{% else %}<p class="memo-empty">No Financial Overview report is available for this selected run.</p>{% endif %}{% endif %}
{% if rms %}{% include 'analysis_memo_rms.html.j2' %}{% endif %}
{% if not view.four_section %}<h2>Material uncertainties &amp; outstanding information</h2><ul>{% for text in (view.synthesis.uncertainties if view.synthesis else []) %}<li>{{ text }}</li>{% endfor %}{% if view.memo %}{% for text in view.memo.outstanding.missing_information or [] %}<li>{{ text }}</li>{% endfor %}{% for finding in view.memo.outstanding.unresolved_challenges or [] %}<li>{{ finding.severity|title }}: {{ finding.reason }}</li>{% endfor %}{% for text in view.memo.outstanding.data_limitations or [] %}<li>{{ text }}</li>{% endfor %}{% endif %}</ul>
{% endif %}
{% if not view.four_section and not pdf %}<h2>Source citations</h2><ul class="source-list">{% for source in view.sources %}<li id="{{ source.anchor }}"><strong>[{{ source.n }}] {{ source.filename or 'Source document' }}</strong>{% if source.href %} · <a href="{{ source.href }}" target="_blank" rel="noopener noreferrer">Open source</a>{% endif %}<small>{{ source.section or '' }} {{ source.location or '' }}{% if source.page %} · Page {{ source.page }}{% endif %}</small>{% if source.excerpt %}<p>{{ source.excerpt }}</p>{% endif %}</li>{% else %}<li>No citations are available for a validated assessment. Inspect Audit &amp; Review for recorded evidence.</li>{% endfor %}</ul>
{% endif %}</article><p class="record-id">Selected run: {{ job.job_id }}</p></main></body></html>
