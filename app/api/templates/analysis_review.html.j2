<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Credit Memo · {{ job.metadata.company or job.folder if pdf else 'Review' }}</title>{% include 'workspace_style.html.j2' %}{% include 'analysis_memo_style.html.j2' %}{% if view.four_section %}{% include 'bo_four_section_style.html.j2' %}{% endif %}{% if pdf %}<style>@page{size:A4;margin:{% if view.four_section %}12{% else %}16{% endif %}mm 14mm}:root,body{background:var(--c-ffffff)}:root{font-size:14px}.analysis-header h1{font-size:30px;font-weight:700}body{max-width:none;padding:0}.memo-paper{border:0;padding:0}.memo-table-wrap{overflow:visible}.memo-claim,.memo-scores>div,.memo-table tr,.source-list li{break-inside:avoid}body,h1,h2,h3{font-family:Georgia,"Times New Roman",serif}.eyebrow,.analysis-meta,.memo-status,.notice-warning,.technical-note,.memo-empty,.memo-scores,.memo-table,.source-cite,.source-list small,.record-id{font-family:Arial,Helvetica,sans-serif}</style>{% endif %}</head><body>{% set active='memos' %}{% if not pdf %}{% include 'analysis_nav.html.j2' %}{% endif %}{% from 'credit_macros.html.j2' import usd, sc with context %}
{% macro claim(c) %}{% if c %}<div class="memo-claim" id="{{ c.anchor }}">{% if c.title %}<strong>{{ c.title }}</strong>{% endif %}<p>{{ c.text }} {% for source in c.sources %}<a class="source-cite" href="#{{ source.anchor }}" aria-label="Source {{ source.n }}">[{{ source.n }}]</a>{% endfor %}</p>{% if c.uncertainty %}<p class="qualification">{{ c.uncertainty }}</p>{% endif %}{% if c.missing_citations %}<p class="qualification">Some recorded evidence references have no corresponding source citation.</p>{% endif %}</div>{% endif %}{% endmacro %}
{% set analysis_period = view.four_section.memo.identity.as_of_date if view.four_section else view.memo.case.as_of_date if view.memo else none %}{% include 'analysis_tabs.html.j2' %}
<main>{% if job.metadata.test_state or (view.memo and view.memo.run.execution_mode == 'offline_simulation') %}<p class="notice-warning"><strong>Synthetic / offline record.</strong> {{ job.metadata.test_state or 'Scripted model responses; this is not a live generated credit memo.' }}</p>{% endif %}
<div class="memo-status">Execution: <strong>{{ job.execution_status|title }}</strong> · Credit memo: <strong>{{ view.governance }}</strong></div>
{% if not pdf and job.execution_status == 'completed' %}<div class="memo-actions"><a class="memo-button primary" href="/analysis/{{ job.job_id|urlencode }}/memo.pdf" download>Download PDF</a></div>{% endif %}
{% if not job.bo_validators %}<p class="notice-warning">Exploratory, ungoverned output. Final approval is prohibited.</p>{% endif %}
<article class="memo-paper" aria-label="Selected run credit memo">{% if not job.fo_only %}{% if view.four_section %}{% set bo4 = view.four_section %}{% include 'bo_four_section.html.j2' %}{% else %}<h2>Executive Business Credit Assessment</h2>
{% if view.synthesis %}{{ claim(view.synthesis.assessment) }}<p class="technical-note">{{ view.synthesis.origin_notice }}</p>{% else %}<p class="notice-warning">No validated Business Credit Assessment is available for this run.</p><p class="memo-empty">{{ view.reason }}</p>{% endif %}
<div class="memo-columns"><section><h2>Key Credit Strengths</h2>{% for c in (view.synthesis.strengths if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated synthesized strengths available.</p>{% endfor %}</section><section><h2>Key Credit Vulnerabilities</h2>{% for c in (view.synthesis.weaknesses if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated synthesized vulnerabilities available.</p>{% endfor %}</section></div>
<h2>Integrated Business Overview</h2>{% for c in (view.synthesis.integrated if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated integrated conclusions available.</p>{% endfor %}{% if view.bo and not pdf %}<p><a href="/cases/{{ job.case_id }}/bo/runs/{{ view.bo.analysis_run_id }}/memo.html">Open the recorded Business Overview memo</a></p>{% endif %}{% endif %}
{% endif %}{% if not job.bo_only %}<h2>Financial Overview</h2>{% if view.financial %}{% with memo = view.financial, fo_tab = none if pdf else (analysis.tabs|selectattr('key', 'equalto', 'fo')|first).href %}{% include 'fo_memo_section.html.j2' %}{% endwith %}{% if not pdf %}<p><a href="/cases/{{ job.case_id }}/fo/runs/{{ view.fo.run_id }}/memo.html">Open the recorded Financial Overview memo</a></p>{% endif %}{% else %}<p class="memo-empty">No Financial Overview report is available for this selected run.</p>{% endif %}{% endif %}
{% if rms %}{% include 'analysis_memo_rms.html.j2' %}{% endif %}
{% if not view.four_section %}<h2>Material uncertainties &amp; outstanding information</h2><ul>{% for text in (view.synthesis.uncertainties if view.synthesis else []) %}<li>{{ text }}</li>{% endfor %}{% if view.memo %}{% for text in view.memo.outstanding.missing_information or [] %}<li>{{ text }}</li>{% endfor %}{% for finding in view.memo.outstanding.unresolved_challenges or [] %}<li>{{ finding.severity|title }}: {{ finding.reason }}</li>{% endfor %}{% for text in view.memo.outstanding.data_limitations or [] %}<li>{{ text }}</li>{% endfor %}{% endif %}</ul>
{% endif %}
{% if not view.four_section %}<h2>Source citations</h2><ul class="source-list">{% for source in view.sources %}<li id="{{ source.anchor }}"><strong>[{{ source.n }}] {{ source.filename or 'Source document' }}</strong>{% if source.href %} · <a href="{{ source.href }}" target="_blank" rel="noopener noreferrer">Open source</a>{% endif %}<small>{{ source.section or '' }} {{ source.location or '' }}{% if source.page %} · Page {{ source.page }}{% endif %}</small>{% if source.excerpt %}<p>{{ source.excerpt }}</p>{% endif %}</li>{% else %}<li>No citations are available for a validated assessment. Inspect Audit &amp; Review for recorded evidence.</li>{% endfor %}</ul>
{% endif %}</article><p class="record-id">Selected run: {{ job.job_id }}</p></main></body></html>
