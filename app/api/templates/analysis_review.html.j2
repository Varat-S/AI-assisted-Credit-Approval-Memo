<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Credit Memo · Review</title>{% include 'workspace_style.html.j2' %}{% include 'analysis_memo_style.html.j2' %}</head><body>{% set active='memos' %}{% include 'analysis_nav.html.j2' %}
{% macro claim(c) %}{% if c %}<div class="memo-claim" id="{{ c.anchor }}">{% if c.title %}<strong>{{ c.title }}</strong>{% endif %}<p>{{ c.text }} {% for source in c.sources %}<a class="source-cite" href="#{{ source.anchor }}" aria-label="Source {{ source.n }}">[{{ source.n }}]</a>{% endfor %}</p>{% if c.uncertainty %}<p class="qualification">{{ c.uncertainty }}</p>{% endif %}{% if c.missing_citations %}<p class="qualification">Some recorded evidence references have no corresponding source citation.</p>{% endif %}</div>{% endif %}{% endmacro %}
<header class="setup-header memo-header"><div><span class="eyebrow">Credit Memos · Review</span><h1>{{ job.metadata.company or job.folder }}</h1><div class="memo-meta"><span>Reporting period: {{ job.metadata.reporting_period or (view.memo.case.as_of_date if view.memo else 'Not recorded') }}</span><span>{{ 'Business Overview Only' if job.bo_only else 'Business + Financial Overview' }}</span><span>{{ 'Standard' if job.bo_validators else 'Exploratory' }}</span></div></div></header>
<main>{% if job.metadata.test_state or (view.memo and view.memo.run.execution_mode == 'offline_simulation') %}<p class="notice-warning"><strong>Synthetic / offline record.</strong> {{ job.metadata.test_state or 'Scripted model responses; this is not a live generated credit memo.' }}</p>{% endif %}
<div class="memo-status">Execution: <strong>{{ job.execution_status|title }}</strong> · Credit memo: <strong>{{ view.governance }}</strong></div>
<div class="memo-actions"><a class="memo-button" href="/credit-memos">Credit Memos</a><a class="memo-button" href="/analysis/{{ job.job_id }}/execution">Execution details</a><a class="memo-button primary" href="/analysis/{{ job.job_id }}/audit">Audit &amp; Review</a></div>
{% if not job.bo_validators %}<p class="notice-warning">Exploratory, ungoverned output. Final approval is prohibited.</p>{% endif %}
<article class="memo-paper" aria-label="Selected run credit memo"><h2>Executive Business Credit Assessment</h2>
{% if view.synthesis %}{{ claim(view.synthesis.assessment) }}<p class="technical-note">{{ view.synthesis.origin_notice }}</p>{% else %}<p class="notice-warning">No validated Business Credit Assessment is available for this run.</p><p class="memo-empty">{{ view.reason }}</p>{% endif %}
<div class="memo-columns"><section><h2>Key Credit Strengths</h2>{% for c in (view.synthesis.strengths if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated synthesized strengths available.</p>{% endfor %}</section><section><h2>Key Credit Vulnerabilities</h2>{% for c in (view.synthesis.weaknesses if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated synthesized vulnerabilities available.</p>{% endfor %}</section></div>
<h2>Integrated Business Overview</h2>{% for c in (view.synthesis.integrated if view.synthesis else []) %}{{ claim(c) }}{% else %}<p class="memo-empty">No validated integrated conclusions available.</p>{% endfor %}
{% if not job.bo_only %}<h2>Financial Overview</h2>{% if view.financial %}<p>{{ view.financial.executive.headline }}</p><p class="memo-empty">{{ view.financial.status.text }}</p><div class="memo-table-wrap"><table class="memo-table"><thead><tr><th>Measure</th><th>Recorded period and value</th><th>Risk score</th></tr></thead><tbody>{% for measure in view.financial.measures %}<tr><td>{{ measure.title }}</td><td>{% if measure.primary %}{% for period in measure.primary.periods %}{{ period.heading }}: {{ period.value.text if period.value is mapping else period.value }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% else %}Not scored{% endif %}</td><td>{{ measure.score.text }} · {{ measure.score.label }}</td></tr>{% endfor %}</tbody></table></div><p><a href="/cases/{{ job.case_id }}/fo/runs/{{ view.fo.run_id }}/memo.html">Open the recorded Financial Overview memo</a></p>{% else %}<p class="memo-empty">No Financial Overview report is available for this selected run.</p>{% endif %}{% endif %}
<h2>Material uncertainties &amp; outstanding information</h2><ul>{% for text in (view.synthesis.uncertainties if view.synthesis else []) %}<li>{{ text }}</li>{% endfor %}{% if view.memo %}{% for text in view.memo.outstanding.missing_information or [] %}<li>{{ text }}</li>{% endfor %}{% for finding in view.memo.outstanding.unresolved_challenges or [] %}<li>{{ finding.severity|title }}: {{ finding.reason }}</li>{% endfor %}{% for text in view.memo.outstanding.data_limitations or [] %}<li>{{ text }}</li>{% endfor %}{% endif %}</ul>
{% if view.financial %}{% for category,items in view.financial.outstanding.items() %}{% if items %}<h3>{{ category|replace('_',' ')|title }}</h3><ul>{% for item in items %}<li>{{ item if item is string else item.reason or item.title or item.measure or 'See recorded financial details.' }}</li>{% endfor %}</ul>{% endif %}{% endfor %}{% endif %}
<h2>Source citations</h2><ul class="source-list">{% for source in view.sources %}<li id="{{ source.anchor }}"><strong>[{{ source.n }}] {{ source.filename or 'Source document' }}</strong>{% if source.href %} · <a href="{{ source.href }}" target="_blank" rel="noopener noreferrer">Open source</a>{% endif %}<small>{{ source.section or '' }} {{ source.location or '' }}{% if source.page %} · Page {{ source.page }}{% endif %}</small>{% if source.excerpt %}<p>{{ source.excerpt }}</p>{% endif %}</li>{% else %}<li>No citations are available for a validated assessment. Inspect Audit &amp; Review for recorded evidence.</li>{% endfor %}</ul>
</article><p class="record-id">Selected run: {{ job.job_id }}</p></main></body></html>
