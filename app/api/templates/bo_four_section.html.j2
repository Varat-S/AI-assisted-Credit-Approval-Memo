{# Read-only display copy of the strictly verified selected-run artifact. #}
{% macro finding_icon(kind) %}<svg class="bo-badge-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{% if kind == 'fact' %}<path d="M11.5 2.5H5a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7l-4.5-4.5Z"/><path d="M11 2.5V7h5M6.5 11l2 2 4-4"/>{% elif kind == 'inference' %}<circle cx="4" cy="5" r="2"/><circle cx="16" cy="5" r="2"/><circle cx="10" cy="15" r="2.5"/><path d="m5 7 3.5 5.5M15 7l-3.5 5.5M6 5h8"/>{% elif kind == 'assumption' %}<path d="m10 2 8 8-8 8-8-8 8-8Z"/><path d="M8 7.5a2 2 0 1 1 3.1 1.7c-.8.4-1.1.8-1.1 1.8M10 14h.01"/>{% elif kind == 'calculated_fact' %}<rect x="4" y="2" width="12" height="16" rx="2"/><path d="M7 6h6M7 10h.01M10 10h.01M13 10h.01M7 14h.01M10 14h.01M13 14h.01"/>{% else %}<path d="M4 3h12a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H8l-5 3V4a1 1 0 0 1 1-1Z"/><path d="M6 7h8M6 10h5"/>{% endif %}</svg>{% endmacro %}
{% macro warnings(items) %}{% for text in items %}<p class="qualification notice-warning">{{ bo4.warning_text(text) }}</p>{% endfor %}{% endmacro %}
{% macro evidence(item) %}{% if not pdf %}<details class="bo-evidence" data-run-id="{{ bo4.memo.identity.analysis_run_id }}"><summary>Evidence · {{ item.title }}</summary>{{ evidence_body(item) }}</details>{% endif %}{% endmacro %}
{% macro evidence_body(item) %}<div class="bo-evidence-body" id="{{ item.id }}"><p class="record-id">Analysis run: {{ bo4.memo.identity.analysis_run_id }} · Evidence snapshot: {{ bo4.memo.identity.evidence_snapshot_version }}</p>{% for citation in item.citations %}<p class="technical-note">{{ citation.document.filename or citation.passage.document_id }} · {{ citation.passage.section or "Recorded source" }}</p><blockquote>{{ citation.passage.text }}</blockquote>{% if citation.href %}<p><a href="{{ citation.href }}" target="_blank" rel="noopener noreferrer">Open source document</a></p>{% endif %}{% endfor %}{% if not pdf %}<pre>{{ item|tojson(indent=2) }}</pre>{% endif %}</div>{% endmacro %}
{% macro schedule(title, rows, columns, key) %}<h4>{{ title }}</h4>{% if not pdf %}<p class="memo-empty">Scroll horizontally to view all obligation columns.</p>{% endif %}<div class="memo-table-wrap" tabindex="0" role="region" aria-label="{{ title }}"><table class="memo-table bo-debt-table" data-schedule="{{ key }}"><thead><tr>{% for field,label in columns %}<th scope="col">{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr>{% for field,label in columns %}<td>{{ bo4.display(row[field]) }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ columns|length }}">No obligation rows recorded. This does not establish zero debt.</td></tr>{% endfor %}</tbody></table></div>{% endmacro %}
{% macro print_diagram(artifact) %}
{% set company = artifact.companies.values()|first %}
{% set bounds = namespace(left=none, top=none, right=none, bottom=none) %}
{% for node in company.nodes %}{% set b = node.box %}
{% set left = b.center_x_px - b.width_px / 2 %}{% set right = b.center_x_px + b.width_px / 2 %}
{% set bottom = b.top_y_px + b.height_px %}
{% set bounds.left = left if bounds.left is none or left < bounds.left else bounds.left %}
{% set bounds.top = b.top_y_px if bounds.top is none or b.top_y_px < bounds.top else bounds.top %}
{% set bounds.right = right if bounds.right is none or right > bounds.right else bounds.right %}
{% set bounds.bottom = bottom if bounds.bottom is none or bottom > bounds.bottom else bounds.bottom %}
{% endfor %}
{# Frame existing SVG geometry around the recorded nodes; never redraw the diagram. #}
<div class="bo-print-diagram" role="img" aria-label="Recorded corporate structure diagram"><svg xmlns="http://www.w3.org/2000/svg" viewBox="{{ bounds.left - 32 }} {{ bounds.top - 32 }} {{ bounds.right - bounds.left + 64 }} {{ bounds.bottom - bounds.top + 64 }}">{{ bo4.svg }}</svg></div>
<p class="technical-note">Guarantor indicator: {{ artifact.visual_spec.legend.entries[-1].symbol }} ({{ artifact.visual_spec.legend.entries[-1].label }}).</p>
{% endmacro %}
<div class="bo-four-section" data-document="{{ bo4.memo.document }}" data-schema-version="{{ bo4.memo.schema_version }}" data-run-id="{{ bo4.memo.identity.analysis_run_id }}">
<div class="memo-status">Business Overview completeness: <strong>{{ bo4.memo.governance.memo_completeness|title }}</strong> · Recorded outcome: <strong>{{ bo4.memo.governance.conclusion_status|replace('_',' ') }}</strong> · Current human review: <strong>{{ bo4.review.status|title }}</strong>{% if bo4.review.reviewer %} · {{ bo4.review.reviewer }}{% endif %}</div>
{% if bo4.memo.example_only %}<p class="notice-warning">Offline / scripted execution. This does not establish live analytical quality.</p>{% endif %}
{% for section in bo4.memo.sections %}<section class="bo-memo-section{% if loop.index == 3 %} bo-competitive-positioning{% endif %}" data-memo-section="{{ section.id }}" data-status="{{ section.status }}" aria-labelledby="bo-section-{{ loop.index }}">
<h2 id="bo-section-{{ loop.index }}"><span class="bo-section-number">{{ '%02d'|format(loop.index) }}</span> {{ section.title }}</h2>
{% if loop.index == 1 %}<div class="memo-columns bo-structure-debt">
<div class="bo-structure"><h3>Corporate Structure</h3>{% if bo4.svg %}{% if pdf %}{{ print_diagram(section.structure.content) }}{% else %}<div class="bo-diagram" role="img" aria-label="Recorded corporate structure diagram">{{ bo4.svg }}</div>{% endif %}{% if not pdf %}<details class="bo-diagram-zoom bo-structure-text" data-run-id="{{ bo4.memo.identity.analysis_run_id }}"><summary>Text ownership hierarchy</summary><pre class="bo-tree" aria-label="Recorded ownership hierarchy">{{ bo4.structure_tree }}</pre></details><details class="bo-diagram-zoom" data-run-id="{{ bo4.memo.identity.analysis_run_id }}"><summary>Enlarge corporate structure</summary><div class="bo-diagram-full">{{ bo4.svg }}</div></details>{% endif %}{% else %}<p class="memo-empty">Corporate structure is not available for this run.</p>{% endif %}{% if pdf and section.structure.content %}{{ warnings([section.structure.content.simulation_disclaimer]) }}{% else %}{{ warnings(section.structure.visible_warnings) }}{% endif %}{{ evidence(section.structure.evidence) }}</div>
{% if pdf %}<div class="bo-debt-summary"><h3>Debt Obligations</h3>{% set summary = section.debt_obligations.content %}
{% if summary %}<p class="technical-note">Recorded debt figures. Complete instrument schedules, guarantees, security and creditor-priority detail follow on subsequent pages.</p>
<table class="memo-table bo-debt-summary-table"><thead><tr><th scope="col">Recorded measure</th><th scope="col">Value</th></tr></thead><tbody>{% for field,label in bo4.priority_columns[:5] %}<tr><th scope="row">{{ label }}</th><td>{{ bo4.display(summary.creditor_priority_framework[field]) }}</td></tr>{% endfor %}{% for item in summary.reconciling_items %}<tr><th scope="row">{{ item.label }} (US$ m, signed)</th><td>{{ item.amount_m }}</td></tr>{% endfor %}</tbody></table>
{% else %}<p class="memo-empty">Debt obligations are not available as validated content for this run.</p>{% endif %}{{ warnings(section.debt_obligations.visible_warnings) }}</div></div>{% endif %}
<div class="bo-debt{% if pdf and section.debt_obligations.content %} bo-print-schedules{% endif %}"><h3>{% if pdf %}Complete Debt Obligations{% else %}Debt Obligations{% endif %}</h3>{% if pdf %}{{ warnings(section.structure.visible_warnings) }}{% endif %}{% set d = section.debt_obligations.content %}{% if d %}
{{ schedule('Senior notes', d.senior_notes_schedule, bo4.note_columns, 'senior_notes') }}
{{ schedule('Non-note obligations and facilities', d.non_note_obligations_schedule, bo4.facility_columns, 'non_note') }}
<h4>Creditor priority and reconciliation</h4><dl class="bo-priority">{% for field,label in bo4.priority_columns %}<dt>{{ label }}</dt><dd>{{ bo4.display(d.creditor_priority_framework[field]) }}</dd>{% endfor %}</dl>
{% if d.reconciling_items %}<div class="memo-table-wrap" tabindex="0" role="region" aria-label="Signed reconciling items"><table class="memo-table"><thead><tr><th scope="col">Reconciling item</th><th scope="col">Signed amount (US$ m)</th></tr></thead><tbody>{% for item in d.reconciling_items %}<tr><td>{{ item.label }}</td><td>{{ item.amount_m }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
{% else %}<p class="memo-empty">Debt obligations are not available as validated content for this run.</p>{% endif %}{{ warnings(section.debt_obligations.visible_warnings) }}{{ evidence(section.debt_obligations.evidence) }}</div>{% if not pdf %}</div>{% endif %}
{% elif loop.index == 2 %}{% set m = section.content %}{% if m %}<div class="memo-claim"><p>{{ m.overall_assessment.policy }}</p>{% if m.overall_assessment.information_gaps %}<p class="qualification">The recorded management assessment contains information gaps.</p>{% endif %}</div>
<h3>Management profiles</h3>{% for profile in m.profiles %}<div class="memo-claim"><h4>{{ profile.name }} · {{ profile.position }}</h4><p>Appointment: {{ profile.appointment_date or 'Not recorded' }}{% if profile.appointment_precision %} ({{ profile.appointment_precision }}){% endif %}</p>{% if profile.tenure %}<p>Recorded tenure: {{ profile.tenure.minimum_days }} to {{ profile.tenure.maximum_days }} days as of {{ profile.tenure.as_of }}</p>{% endif %}{% if profile.succession %}<p>Succession: {{ profile.succession|replace("_"," ")|capitalize }}</p>{% endif %}{% for role in profile.prior_internal_roles %}<p>{{ role.position }} · {{ role.start_date or 'Not recorded' }} to {{ role.end_date or 'Not recorded' }}</p>{% endfor %}</div>{% endfor %}
<h3>Reviewed observations</h3>{% for observation in m.observations if observation.review_outcome in ['accepted','qualified'] %}<div class="memo-claim"><p>{{ observation.text }}</p>{% if observation.review_outcome == 'qualified' %}<p class="qualification">Qualified observation: {{ observation.review_reason }}</p>{% endif %}{% for text in observation.uncertainties %}<p class="qualification">{{ text }}</p>{% endfor %}</div>{% endfor %}
{% for text in m.coverage.missing %}<p class="qualification">{{ text }}</p>{% endfor %}
{% else %}<p class="memo-empty">Reviewed management analysis is not available for this run.</p>{% endif %}{{ warnings(section.visible_warnings) }}{{ evidence(section.evidence) }}
{% elif loop.index == 3 %}{% if section.content %}{% if bo4.finding_groups is defined and bo4.finding_groups is not none %}
{% for group in bo4.finding_groups %}<div class="bo-finding-group"><h3>{{ group.title }}</h3>{% if not group.entries %}<p class="memo-empty">No selected findings were recorded in this category.</p>{% endif %}
{% for entry in group.entries %}<div class="memo-claim" data-claim-id="{{ entry.claim.claim_id }}" data-source-finding="{{ entry.source_hypothesis_id }}">
<h4>{{ entry.topic }}</h4><div class="bo-finding-badges" role="group" aria-label="Finding classification and direction"><span class="bo-finding-badge bo-badge-type bo-type-{{ entry.claim.claim_type }}">{{ finding_icon(entry.claim.claim_type) }}<span>{{ entry.claim_type_label }}</span></span><span class="bo-finding-badge bo-badge-direction bo-direction-{{ entry.direction_label|lower }}"><span class="bo-direction-sign" aria-hidden="true">{% if entry.direction_label == 'Positive' %}+{% elif entry.direction_label == 'Negative' %}−{% elif entry.direction_label == 'Mixed' %}±{% else %}—{% endif %}</span><span>{{ entry.direction_label }}</span></span></div>
{% if entry.pointers is defined %}<dl class="bo-finding-points">{% for pointer in entry.pointers %}<div class="bo-finding-point"><dt>{{ pointer.label }}</dt><dd>{% if pointer.parts %}{% for part in pointer.parts %}<p>{{ part.text }}</p>{% endfor %}{% else %}<p class="memo-empty">{{ pointer.empty_text }}</p>{% endif %}</dd></div>{% endfor %}</dl>{% else %}<p>{{ entry.claim.text }}</p>{% for detail in entry.details %}<p><strong>{{ detail.label }}:</strong> {{ detail.text }}</p>{% endfor %}{% endif %}
{% if entry.claim.uncertainty %}<p class="qualification">{{ entry.claim.uncertainty }}</p>{% endif %}{{ evidence(entry.evidence) }}</div>{% endfor %}</div>{% endfor %}
{% else %}{% for entry in bo4.claims %}<div class="memo-claim" data-claim-id="{{ entry.claim.claim_id }}">{% if not loop.first %}<h3>{{ entry.category }}{% if entry.claim.title %} · {{ entry.claim.title }}{% endif %}</h3>{% endif %}<p>{{ entry.claim.text }}</p>{% if entry.claim.uncertainty %}<p class="qualification">{{ entry.claim.uncertainty }}</p>{% endif %}{{ evidence(entry.evidence) }}</div>{% endfor %}{% endif %}{% else %}<p class="memo-empty">Competitive Positioning is not available as validated content for this run.</p>{% endif %}{{ warnings(section.visible_warnings) }}{{ evidence(section.evidence) }}
{% else %}{% if section.content and section.content.findings %}{% for finding in section.content.findings %}<div class="memo-claim"><p>{{ finding.claim }}</p>{% if finding.credit_mechanism %}<p>{{ finding.credit_mechanism }}</p>{% endif %}{% for key,text in finding.interpretation.items() if text %}<p>{{ text }}</p>{% endfor %}{% for text in finding.missing_information %}<p class="qualification">{{ text }}</p>{% endfor %}</div>{% endfor %}{% else %}<p class="memo-empty">Industry analysis is not available in this version.</p>{% endif %}{{ warnings(section.visible_warnings) }}{{ evidence(section.evidence) }}{% endif %}
</section>{% endfor %}
{% if pdf %}<aside class="bo-evidence-appendix" aria-label="Business Overview evidence appendix"><h2>Business Overview evidence appendix</h2><p>Static export of the selected run's supporting records. Evidence is collapsed in the interactive memo.</p>{% for item in bo4.evidence %}<h3>{{ item.title }}</h3>{{ evidence_body(item) }}{% endfor %}</aside>{% endif %}
</div>
