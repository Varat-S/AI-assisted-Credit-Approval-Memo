<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} · Pipeline report</title>
{% include 'workspace_style.html.j2' %}{% include 'analysis_memo_style.html.j2' %}{% include 'memo_typography.html.j2' %}
<style>
:root{color-scheme:light}body{max-width:1200px;padding:22px;margin:0 auto;background:var(--c-f5f6f4,#f5f6f4);color:var(--c-192b3b,#192b3b)}*{box-sizing:border-box}a{color:var(--c-1e5d60,#1e5d60)}button,.action{border:1px solid var(--c-c7d5d4,#c7d5d4);border-radius:6px;background:#fff;padding:8px 12px;color:var(--c-294f53,#294f53);font:inherit;cursor:pointer;text-decoration:none}.report-head{margin-bottom:16px}.report-head h1{font-size:24px;margin:5px 0 8px;overflow-wrap:anywhere}.record-id{overflow-wrap:anywhere;font-size:12px;color:var(--c-62707b,#62707b)}.statuses{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.state{border:1px solid var(--c-d8dfdf,#d8dfdf);border-radius:5px;padding:5px 8px;font-size:12px;background:white}.state strong{margin-left:5px}.state.failed,.state.rejected{border-color:var(--c-9a3324,#9a3324);color:var(--c-9a3324,#9a3324)}.state.pending,.state.qualified{border-color:var(--c-b39452,#b39452);color:var(--c-846516,#846516)}.tabs{display:flex;border-bottom:1px solid var(--c-c7d5d4,#c7d5d4);gap:4px;position:sticky;top:0;background:var(--c-f5f6f4,#f5f6f4);padding:8px 0;z-index:2}.tabs button[aria-selected=true]{background:var(--c-294f53,#294f53);color:white}.tabs button{font-size:13px}.memo-paper{padding:25px;min-width:0;border-radius:8px}.memo-paper h2{border-bottom:1px solid var(--c-c7d5d4,#c7d5d4);padding-bottom:8px;margin-top:28px}.memo-paper h2:first-child{margin-top:0}.fields{display:grid;grid-template-columns:minmax(110px,30%) minmax(0,1fr);gap:6px 16px;margin:8px 0}.fields dt{color:var(--c-62707b,#62707b);font-size:12px;overflow-wrap:anywhere}.fields dd{margin:0;min-width:0;overflow-wrap:anywhere}.fields p{margin:0}.record-card{border:1px solid var(--c-dce2e1,#dce2e1);border-left:3px solid var(--c-719596,#719596);padding:12px 16px;margin:10px 0;background:#fff;border-radius:5px}.record-card summary{color:var(--c-315e62,#315e62);cursor:pointer}.table-wrap{max-width:100%;overflow:auto}.memo-table{width:100%;border-collapse:collapse}.memo-table th,.memo-table td{padding:8px;text-align:left;vertical-align:top;border-bottom:1px solid var(--c-dce2e1,#dce2e1);min-width:100px;overflow-wrap:anywhere}.memo-table th{background:var(--c-edf4f2,#edf4f2);color:var(--c-315e62,#315e62)}.notice{border-left:3px solid var(--c-b39452,#b39452);background:var(--c-fcf8f0,#fcf8f0);padding:12px 16px;margin:12px 0;font-size:12px}.empty{color:var(--c-62707b,#62707b)}.actions{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.diagram svg{width:100%;height:auto;min-width:500px}.diagram{overflow:auto}.json-viewer details{border-left:1px solid var(--c-c7d5d4,#c7d5d4);margin:5px 0 5px 6px;padding-left:10px}.json-viewer summary{cursor:pointer;color:var(--c-315e62,#315e62)}.jv-row{display:flex;gap:10px}.jv-key{color:var(--c-62707b,#62707b);min-width:100px}.jv-val{overflow-wrap:anywhere}.jv-table{border-collapse:collapse}.jv-table td,.jv-table th{border:1px solid var(--c-dce2e1,#dce2e1);padding:6px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;background:var(--c-f5f8f7,#f5f8f7);padding:15px}section[hidden]{display:none}.evidence-link{font-size:12px;overflow-wrap:anywhere}.audit-card:target{background:var(--c-f4f7e9,#f4f7e9);scroll-margin-top:60px}.provenance{font-size:12px;color:var(--c-62707b,#62707b)}ul{padding-left:20px}.record-card h3{margin:0 0 8px}@media(max-width:600px){body{padding:12px}.memo-paper{padding:16px}.fields{grid-template-columns:1fr;gap:2px}.fields dd{margin-bottom:8px}.tabs button{padding:8px}.report-head h1{font-size:20px}}
</style></head><body>
{% macro value(v, depth=0, key='') -%}
{% if v is mapping %}
{% if (v.get('claim') is string) or (v.get('text') is string) %}
<p class="memo-claim">{{ v.get('claim') or v.get('text') }}</p>
<div class="statuses">{% for field in ['disposition','acceptance_state','direction','materiality','review_status'] %}{% if v.get(field) %}<span class="state">{{ humanize(field) }} <strong>{{ v[field]|replace('_',' ') }}</strong></span>{% endif %}{% endfor %}</div>
{% for field in ['credit_mechanism','qualifications','limitations','missing_information','uncertainties','evidence_quotes','supporting_evidence_ids','evidence_ids'] %}{% if v.get(field) %}<h4>{{ humanize(field) }}</h4>{{ value(v[field],depth+1,field) }}{% endif %}{% endfor %}
<details><summary>Recorded finding details</summary><dl class="fields">{% for k,x in v.items() %}<dt>{{ humanize(k) }}</dt><dd>{{ value(x,depth+1,k) }}</dd>{% endfor %}</dl></details>
{% elif depth==0 %}{% for k,x in v.items() %}{% if x is mapping or (x is sequence and x is not string) %}<div class="report-block"><h3>{{ humanize(k) }}</h3>{{ value(x,depth+1,k) }}</div>{% else %}<dl class="fields"><dt>{{ humanize(k) }}</dt><dd>{{ value(x,depth+1,k) }}</dd></dl>{% endif %}{% else %}<p class="empty">No entries recorded.</p>{% endfor %}
{% else %}<dl class="fields">{% for k,x in v.items() %}<dt>{{ humanize(k) }}</dt><dd>{{ value(x,depth+1,k) }}</dd>{% else %}<dd class="empty">No entries recorded.</dd>{% endfor %}</dl>{% endif %}
{% elif v is sequence and v is not string %}
{% if not v %}<span class="empty">No entries recorded.</span>
{% elif table_columns(v) %}{% set cols=table_columns(v) %}<div class="table-wrap"><table class="memo-table"><thead><tr>{% for col in cols %}<th>{{ humanize(col) }}</th>{% endfor %}</tr></thead><tbody>{% for row in v %}<tr>{% for col in cols %}<td>{{ value(row.get(col),depth+1,col) }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
{% else %}{% for item in v %}{% if item is mapping %}<div class="record-card">{{ value(item,depth+1,key) }}</div>{% else %}<p>{{ value(item,depth+1,key) }}</p>{% endif %}{% endfor %}{% endif %}
{% elif v is none %}<span class="empty">Not recorded</span>
{% elif v is boolean %}{{ 'Yes' if v else 'No' }}
{% elif key in ['evidence_id','evidence_ids','source_id','source_fact_ids','citation_ids','citation_id','evidence_refs','packet_evidence_ids','supporting_evidence_ids','contradicting_evidence_ids'] %}<a class="evidence-link" href="#{{ evidence_anchor(v) }}" onclick="activate('audit')">{{ v }}</a>
{% else %}{{ v }}{% endif %}
{%- endmacro %}
<header class="report-head"><div class="eyebrow">Recorded stage report · read only</div><h1>{{ title }}</h1><p class="record-id">{{ info.case_id }} · Run {{ info.run_id or 'not recorded' }}<br>{{ info.artifact_id }}</p>
<div class="statuses">{% for key in ['execution','validation','governance'] %}<span class="state {{ info.states[key] }}">{{ key|capitalize }}<strong>{{ info.states[key]|replace('_',' ') }}</strong></span>{% endfor %}</div>
{% if info.status_reason %}<p class="provenance">{{ info.status_reason }}</p>{% endif %}
<div class="actions"><a class="action" href="/pipeline?case={{ info.case_id|urlencode }}&run={{ info.run_id|urlencode }}" target="_top">Return to graph</a>{% if not embedded %}<a class="action" href="/credit-memos">Credit memos &amp; governed review</a>{% endif %}</div></header>
<nav class="tabs" role="tablist" aria-label="Stage details">{% for id,label in [('report','Report'),('audit','Evidence & Audit'),('raw','Raw JSON')] %}<button id="tab-{{ id }}" role="tab" aria-controls="panel-{{ id }}" aria-selected="{{ 'true' if id=='report' else 'false' }}" onclick="activate('{{ id }}')">{{ label }}</button>{% endfor %}</nav>
<main><section class="memo-paper" id="panel-report" role="tabpanel" aria-labelledby="tab-report">
{% for disclosure in report.disclosures %}<div class="notice">{{ disclosure }}</div>{% endfor %}
{% if report.family=='rms' %}<div class="notice"><strong>Provisional RMS recommendation.</strong> The recorded verdict is not final credit approval. Gate warnings and waivers remain subject to the existing governed review process.</div>{% endif %}
{% if not info.payload_available %}<h2>Output unavailable</h2><p>{{ info.status_reason or 'This stage has no persisted output in the selected run.' }}</p>{% else %}
{% if diagram %}<h2>Corporate structure</h2><div class="diagram">{{ diagram }}</div>{% endif %}
{% for section in report.sections %}{% if section.key in ['recorded_details','agent'] and report.family!='generic' %}<details class="record-card"><summary>Additional recorded fields</summary>{{ value(section.value) }}</details>{% else %}<h2>{{ section.title }}</h2>{{ value(section.value) }}{% endif %}{% endfor %}{% endif %}
{% if memo_href %}<p><a href="{{ memo_href }}" target="_top">Open existing governed credit memo for this exact run</a></p>{% endif %}<p class="provenance">{{ report.rendering_note }} Filesystem inspection; frozen database-chain verification remains in the governed memo interface.</p></section>
<section class="memo-paper" id="panel-audit" role="tabpanel" aria-labelledby="tab-audit" hidden>
<h2>Artifact identity &amp; integrity</h2>{{ value(identity) }}<p class="provenance">Filesystem inventory hashes are calculated from the recorded bytes at inspection. A computed hash alone does not establish frozen database-chain or source-binding verification. Existing governed memo routes retain those checks.</p>
{% if review_href %}<p><a href="{{ review_href }}" target="_top">Open existing governed review</a></p>{% endif %}
<h2>Validation, review &amp; unresolved items</h2>{% for signal in report.signals %}<details class="record-card" open><summary>{{ signal.title }}</summary><small>{{ signal.path }}</small>{{ value(signal.value) }}</details>{% else %}<p class="empty">No additional validation or review records are present in this artifact. No successful outcome is inferred.</p>{% endfor %}
<h2>Evidence &amp; source references</h2>{% for source in report.evidence %}<div class="record-card audit-card" id="{{ source.anchor }}"><h3>{{ source.id }}</h3>{% if source.href %}<a href="{{ source.href }}" target="_blank" rel="noopener noreferrer">Open source document</a>{% endif %}{% if source.records %}{% for record in source.records %}{{ value(record) }}{% endfor %}{% else %}<p class="empty">Referenced ID; source document, page and excerpt are not embedded in this artifact.</p>{% endif %}</div>{% else %}<p class="empty">No evidence IDs recorded.</p>{% endfor %}</section>
<section class="memo-paper" id="panel-raw" role="tabpanel" aria-labelledby="tab-raw" hidden><h2>Recorded JSON inspection</h2><p>Parsed recorded output{% if info.is_slice %} · slice of {{ info.file_location }} at {{ info.audit_subpath }}{% endif %}.</p>
{% if info.payload_available %}<div class="actions">{% if not info.is_slice %}<a class="action" href="{{ base }}/original.json{{ pin }}">Download original bytes</a>{% endif %}<a class="action" href="{{ base }}/normalized.json{{ pin }}">Download normalized JSON</a><a class="action" href="{{ base }}/export.pdf{{ pin }}">JSON inspection PDF</a></div><p class="provenance">Original download preserves recorded file bytes. Normalized export reserializes the parsed output and has a separate canonical hash. Slices have no independent original file.</p><div class="table-wrap">{{ raw_html }}</div><details><summary>Formatted JSON text</summary><pre>{{ info.payload|tojson(indent=2) }}</pre></details>{% else %}<p class="empty">No recorded payload to export.</p>{% endif %}</section></main>
<script>
function activate(id){document.querySelectorAll('[role=tabpanel]').forEach(p=>p.hidden=p.id!=='panel-'+id);document.querySelectorAll('[role=tab]').forEach(t=>t.setAttribute('aria-selected',t.id==='tab-'+id));}
document.querySelectorAll('[role=tab]').forEach((t,i)=>t.addEventListener('keydown',e=>{if(['ArrowRight','ArrowLeft'].includes(e.key)){e.preventDefault();const tabs=[...document.querySelectorAll('[role=tab]')],next=tabs[(i+(e.key==='ArrowRight'?1:2))%3];next.click();next.focus();}}));
</script></body></html>
