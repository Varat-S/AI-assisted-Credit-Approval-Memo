<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>New Analysis · Setup</title>{% include 'workspace_style.html.j2' %}</head><body>
{% set active='new' %}{% include 'analysis_nav.html.j2' %}<header class="setup-header"><span class="eyebrow">New Analysis</span><h1>Set up your analysis</h1><p>Choose the scope and safeguards for your credit analysis.</p><ol class="stepper" aria-label="Analysis steps"><li aria-current="step"><span class="step-number">1</span>Setup</li><li aria-disabled="true"><span class="step-number">2</span>Execution</li><li aria-disabled="true"><span class="step-number">3</span>Review</li></ol></header>
<main>{% if errors %}<div class="setup-errors" role="alert"><strong>Setup needs attention</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% elif checked %}<div class="setup-checked" role="status">Configuration checked. Your selections map to the existing analysis workflow. No analysis has been started.</div>{% endif %}
{% if notice %}<div class="setup-checked" role="status">{{ notice }}</div>{% endif %}
<div class="setup-layout"><section class="setup-panel"><h2>Analysis configuration</h2><form method="get" action="/analysis/new" id="setup-form"><input type="hidden" name="submission_key" value="{{ submission_key }}"><input type="hidden" name="check" value="1">
<label for="company">Hospital company</label><select id="company" name="company" required>{% for company in companies %}<option value="{{ company.id }}"{% if company.id == values.company %} selected{% endif %}>{{ company.label }}</option>{% endfor %}</select><p class="hint">Every 10-K filing folder in <code>edgar_filings/</code> is listed.</p>
<fieldset><legend>Analysis scope</legend><label class="choice"><input type="radio" name="sections" value="both"{% if values.sections == 'both' %} checked{% endif %}><span><strong>Business + Financial Overview</strong><small>Prepare both sections using the same evidence package.</small></span></label><label class="choice"><input type="radio" name="sections" value="bo"{% if values.sections == 'bo' %} checked{% endif %}><span><strong>Business Overview Only</strong><small>Specialist analysis and source-only Competitive Positioning selection.</small></span></label><label class="choice"><input type="radio" name="sections" value="fo"{% if values.sections == 'fo' %} checked{% endif %}><span><strong>Financial Overview Only</strong><small>Financial pre-checks, ratios and scoring from the filing's Inline XBRL.</small></span></label></fieldset>
<fieldset><legend>Validation safeguards</legend><label class="choice"><input type="radio" name="validation_mode" value="standard"{% if values.validation_mode == 'standard' %} checked{% endif %}><span><strong>Standard Mode — Safeguards On</strong><small>Existing evidence-grounding and deterministic validations remain enforced.</small></span></label><label class="choice"><input type="radio" name="validation_mode" value="exploratory"{% if values.validation_mode == 'exploratory' %} checked{% endif %}><span><strong>Exploratory Mode — Safeguards Relaxed</strong><small>Specialist validation findings are advisory. Finding selection and source integrity remain enforced.</small></span></label></fieldset>
<p class="hint">This setting applies to Business Overview only. Financial Overview checks, source provenance and integrity protections remain unchanged.</p>
<div class="mode-note" id="exploratory-note"{% if values.validation_mode != 'exploratory' %} hidden{% endif %}><strong>Exploratory, unvalidated output.</strong> Not eligible for final approval. Relaxing safeguards does not establish greater accuracy or usefulness.</div>
<details><summary>Advanced settings</summary><label for="cutoff">Evidence cutoff override (optional)</label><input id="cutoff" name="cutoff" value="{{ values.cutoff }}" placeholder="2025-03-31T23:59:59Z"><p class="hint">Include a timezone. Leave blank to retain the configured evidence cutoff.</p><label for="case_id">Case reference (optional)</label><input id="case_id" name="case_id" value="{{ values.case_id }}" placeholder="Use the existing company and filing reference"><p class="hint">Letters, numbers, underscores, dots and hyphens only.</p></details>
<div class="setup-actions"><button class="secondary-button" type="submit">Check setup</button><button class="primary-button" id="run-analysis" type="submit" formaction="/analysis/start" formmethod="post"{% if not execution_enabled %} disabled aria-disabled="true"{% endif %} aria-describedby="execution-note">Run Analysis</button></div><p class="execution-note" id="execution-note">Run Analysis starts paid AI processing. Checking this setup does not create a run or make a paid AI call. Provider access is checked again on submission.</p>
</form></section>

<aside class="evidence-panel" aria-label="Selected evidence package"><span class="eyebrow">Selected evidence</span>{% if selection %}<p class="evidence-name">{{ selection.company.label }}</p><span class="evidence-tag">FY{{ selection.evidence.report_date.year }} annual report</span><dl><dt>Financial reporting period</dt><dd>Year ended {{ selection.evidence.report_date.strftime('%d %B %Y') }}</dd><dt>Filing date</dt><dd>{{ selection.evidence.filing_date.strftime('%d %B %Y') }}</dd><dt>Evidence cutoff · UTC</dt><dd>{{ selection.evidence.cutoff.strftime('%d %b %Y, %H:%M:%S') }}</dd><dt>Evidence package</dt><dd>{{ selection.evidence.folder }}</dd><dt>Source identifier</dt><dd>{{ selection.evidence.accession }}</dd><dt>Annual report source</dt><dd>{{ selection.evidence.primary_document }}</dd><dt>Package sources</dt><dd>{{ selection.evidence.sources }} files</dd><dt>Corporate structure</dt><dd>{% set extras = saved_extras.get(selection.company.filing_folder) %}{% if extras and extras.structure %}{{ extras.structure }}{% else %}None added · <a href="/analysis/new?company={{ selection.company.id|urlencode }}&amp;add_folder={{ selection.company.filing_folder|urlencode }}#add-evidence">Add one</a>{% endif %}</dd></dl>{% else %}<p class="evidence-name">Evidence unavailable</p><p class="hint">The required company package must be restored or corrected before it can be used.</p>{% endif %}
<div class="readiness">{% if providers.configured %}<strong>Provider settings present</strong>Live connectivity and credentials have not been tested. Readiness is checked again when you submit; model access is confirmed by execution.{% else %}<strong>Provider configuration needed</strong>Review the setup message before live execution is connected.{% endif %}</div></aside>
{% macro extra_inputs(prefix, intro) %}<div class="extras"><p class="hint">{{ intro }}</p>
<label for="{{ prefix }}-structure">Corporate-structure JSON <span class="optional">optional</span></label><input id="{{ prefix }}-structure" name="structure" type="file" accept=".json,application/json">
<p class="hint">The ownership tree for the Module 3 corporate structure chart (a JSON with <code>"document_type": "corporate_structure_onboarding"</code>). It is checked before anything is saved, and saved as <code>m3_corporate_structure.json</code>.</p>
<label for="{{ prefix }}-supporting">Other supporting files <span class="optional">optional</span></label><input id="{{ prefix }}-supporting" name="supporting" type="file" multiple accept="{{ supporting_suffixes|join(',') }}">
<p class="hint">Kept with the filing in <code>supporting/</code> for reference; they are not read as evidence. Allowed: {{ supporting_suffixes|join(', ') }}.</p></div>{% endmacro %}
{% set mode = edgar.mode or 'download' %}
<section class="setup-panel" id="add-evidence" aria-labelledby="add-evidence-title" data-max-bytes="{{ max_file_bytes }}" data-sec-env="{{ 'yes' if sec_env else '' }}" data-extras='{{ saved_extras|tojson }}'>
<h2 id="add-evidence-title">Add a 10-K</h2><p class="hint">Saved filings go to <code>edgar_filings/</code> and then appear in the company list above. How do you want to add one?</p>
{% if edgar.errors %}<div class="setup-errors" role="alert" id="edgar-errors"><strong>That didn't work, and nothing was saved.</strong><ul>{% for error in edgar.errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<div class="mode-tabs" role="radiogroup" aria-label="How to add a 10-K">{% for value, title, text in [('download', 'Download from SEC EDGAR', 'Easiest: you only need the ticker.'), ('upload', 'Upload files I have', "A .zip from EDGAR, or the 10-K's .htm and .xsd files."), ('add', 'Add files to a saved 10-K', 'For example, a corporate-structure JSON you forgot.')] %}<label class="choice mode-tab"><input type="radio" name="evidence_mode" value="{{ value }}"{% if mode == value %} checked{% endif %}><span><strong>{{ title }}</strong><small>{{ text }}</small></span></label>{% endfor %}</div>

<div class="mode-panel" data-mode="download">
<form method="get" action="/analysis/new/reports#add-evidence" class="step"><h3><span class="step-number">1</span>Find the company</h3>
<label for="user_agent">Your email{% if sec_env %} <span class="optional">optional</span>{% endif %}</label><input id="user_agent" name="user_agent" type="email" autocomplete="email" placeholder="you@example.com" value="{{ edgar.user_agent or '' }}"{% if not sec_env %} required{% endif %}><p class="hint">SEC EDGAR asks every request to name a contact. {% if sec_env %}Leave blank to use the contact configured on the server.{% else %}No account or API key is needed. Used only for this request; it is not saved.{% endif %}</p>
<label for="ticker">Ticker</label><input id="ticker" name="ticker" required maxlength="10" autocomplete="off" autocapitalize="characters" spellcheck="false" pattern="[A-Za-z][A-Za-z.\-]{0,9}" title="A stock ticker such as HCA or BRK.B" placeholder="e.g. HCA" value="{{ edgar.ticker or '' }}">
<label class="choice"><input type="checkbox" name="amendments" value="1"{% if edgar.amendments %} checked{% endif %}><span><small>Also list amended 10-Ks (10-K/A)</small></span></label>
<div class="setup-actions"><button class="secondary-button" type="submit" data-busy="Searching SEC EDGAR…">Find 10-Ks</button></div></form>
{% if reports %}{% set usable = reports|rejectattr('problem')|rejectattr('downloaded')|list %}{% set chosen = usable|selectattr('accession', 'equalto', edgar.accession)|first or usable|first %}
<form method="post" action="/analysis/new/fetch" enctype="multipart/form-data" class="step" id="fetch-form"><input type="hidden" name="ticker" value="{{ edgar.company.ticker }}"><input type="hidden" name="user_agent" value="{{ edgar.user_agent or '' }}">
<h3><span class="step-number">2</span>Pick the year: {{ edgar.company.name }} ({{ edgar.company.ticker }})</h3>
<div class="table-wrap"><table><thead><tr><th><span class="visually-hidden">Choose</span></th><th>Fiscal year</th><th>Form</th><th>Period ending</th><th>Filed</th><th>Proxy</th><th>Status</th></tr></thead><tbody>
{% for r in reports %}{% set ok = not r.problem and not r.downloaded %}<tr><td><input type="radio" name="accession" id="acc-{{ loop.index }}" value="{{ r.accession }}"{% if not ok %} disabled{% elif chosen and r.accession == chosen.accession %} checked{% endif %}></td><td><label for="acc-{{ loop.index }}">FY{{ r.fiscal_year }}</label></td><td>{{ r.form }}</td><td>{{ r.report_date }}</td><td>{{ r.filing_date }}</td><td>{{ r.proxy or '—' }}</td><td>{% if r.downloaded %}already in <code>edgar_filings/{{ r.folder }}</code> · <a href="/analysis/new?company={{ folder_ids.get(r.folder, '')|urlencode }}">Use it</a> · <a href="/analysis/new?company={{ folder_ids.get(r.folder, '')|urlencode }}&amp;add_folder={{ r.folder|urlencode }}#add-evidence">Add files to it</a>{% elif r.problem %}{{ r.problem }}{% else %}Ready{% endif %}</td></tr>{% endfor %}</tbody></table></div>
<label class="choice"><input type="checkbox" name="with_proxy" value="1"{% if not edgar.fetch_attempted or edgar.with_proxy %} checked{% endif %}><span><small>Also download the proxy statement (better management, governance and related-party evidence)</small></span></label>
<h3><span class="step-number">3</span>Add your own files <span class="optional">optional</span></h3>
{{ extra_inputs('fetch', 'Saved into the same folder as the download.') }}
<h3><span class="step-number">4</span>Download</h3>
<div class="setup-actions"><button class="primary-button" type="submit" data-busy="Downloading from SEC EDGAR… this can take a minute"{% if not usable %} disabled{% endif %}>Download the selected 10-K</button></div>
{% if not usable %}<p class="hint">Every 10-K listed is already saved or not supported. Pick a saved one in the company list above, or add files to it.</p>{% endif %}
<p class="form-problem" role="alert" hidden></p></form>
{% else %}<p class="hint next-steps">Next you pick the fiscal year, and can attach your own files (such as a corporate-structure JSON) before downloading.</p>{% endif %}
</div>

<div class="mode-panel" data-mode="upload">
<form method="post" action="/analysis/new/import" enctype="multipart/form-data" class="step" id="import-form"><h3><span class="step-number">1</span>Choose the filing</h3>
<label for="files">The 10-K's files</label><input id="files" name="files" type="file" multiple required accept=".zip,.htm,.html,.xhtml,.xml,.xsd">
<p class="hint">Either the .zip EDGAR offers for the filing, or the Inline XBRL 10-K (.htm) together with its .xsd and linkbase (.xml) files. Hold Ctrl or Shift to select several files.</p>
<h3><span class="step-number">2</span>Identify it</h3>
<label for="import-user-agent">Your email <span class="optional">{{ 'optional' if sec_env else 'recommended' }}</span></label><input id="import-user-agent" name="user_agent" type="email" autocomplete="email" placeholder="you@example.com" value="{{ edgar.user_agent or '' }}">
<p class="hint">With an email{% if sec_env %} (or the contact configured on the server){% endif %}, the accession and filing date are looked up and checked on SEC EDGAR, so you can leave them blank. Without one, enter both; they are recorded as declared by you.</p>
<label for="import-accession">Accession</label><input id="import-accession" name="accession" placeholder="0001193125-26-044769" pattern="\d{10}-\d{2}-\d{6}" title="Format: 0001193125-26-044769 (10 digits, 2 digits, 6 digits)" value="{{ edgar.accession or '' }}">
<label for="filing_date">Filing date</label><input id="filing_date" name="filing_date" type="date" value="{{ edgar.filing_date or '' }}">
<label for="import-ticker">Ticker <span class="optional">optional</span></label><input id="import-ticker" name="ticker" maxlength="10" autocapitalize="characters" spellcheck="false" placeholder="Read from the cover page if blank" value="{{ edgar.import_ticker or '' }}">
<h3><span class="step-number">3</span>Add your own files <span class="optional">optional</span></h3>
{{ extra_inputs('import', 'Saved into the same folder as the filing.') }}
<div class="setup-actions"><button class="primary-button" type="submit" data-busy="Uploading and checking the filing…">Upload and save</button></div>
<p class="form-problem" role="alert" hidden></p></form>
</div>

<div class="mode-panel" data-mode="add">
<form method="post" action="/analysis/new/add-files" enctype="multipart/form-data" class="step" id="add-form"><h3><span class="step-number">1</span>Choose the saved 10-K</h3>
<label for="add-folder">Saved 10-K</label><select id="add-folder" name="folder" required><option value="">Choose a filing…</option>{% for company in companies %}<option value="{{ company.filing_folder }}"{% if company.filing_folder == edgar.folder %} selected{% endif %}>{{ company.label }}</option>{% endfor %}</select>
<p class="hint saved-state" id="add-folder-state" aria-live="polite"></p>
<h3><span class="step-number">2</span>Choose the files</h3>
{{ extra_inputs('add', 'Added to the folder you chose. The SEC files themselves are not changed.') }}
<label class="choice"><input type="checkbox" name="replace_structure" value="1"{% if edgar.replace_structure %} checked{% endif %}><span><small>If this 10-K already has a corporate structure, replace it (the old file is kept in <code>supporting/superseded/</code>)</small></span></label>
<div class="setup-actions"><button class="primary-button" type="submit" data-busy="Saving your files…">Add files</button></div>
<p class="form-problem" role="alert" hidden></p></form>
</div></section></div></main>
<script>(function(){const note=document.getElementById('exploratory-note');document.querySelectorAll('input[name="validation_mode"]').forEach(function(input){input.addEventListener('change',function(){note.hidden=document.querySelector('input[name="validation_mode"]:checked').value!=='exploratory';});});})();document.getElementById('company').addEventListener('change',function(){var form=document.getElementById('setup-form'),q=new URLSearchParams();q.set('company',this.value);['sections','validation_mode'].forEach(function(n){var c=form.querySelector('input[name="'+n+'"]:checked');if(c)q.set(n,c.value);});window.location.href='/analysis/new?'+q.toString();});document.getElementById('setup-form').addEventListener('submit',function(event){if(event.submitter && event.submitter.id==='run-analysis'){this.action='/analysis/start';this.method='post';event.submitter.disabled=true;event.submitter.textContent='Starting analysis…';}});</script>
<script>(function(){var section=document.getElementById('add-evidence');if(!section)return;
var max=Number(section.dataset.maxBytes),secEnv=!!section.dataset.secEnv,saved={};try{saved=JSON.parse(section.dataset.extras||'{}');}catch(e){}
var errors=document.getElementById('edgar-errors');if(errors)errors.scrollIntoView({block:'center'});
function all(root,sel){return Array.prototype.slice.call(root.querySelectorAll(sel));}
function files(form){return all(form,'input[type=file]').reduce(function(list,input){return list.concat(Array.prototype.slice.call(input.files));},[]);}
['ticker','import-ticker'].forEach(function(id){var input=document.getElementById(id);if(input)input.addEventListener('input',function(){var at=input.selectionStart;input.value=input.value.toUpperCase();input.setSelectionRange(at,at);});});
all(section,'tbody tr').forEach(function(row){var radio=row.querySelector('input[type=radio]:not([disabled])');if(radio)row.addEventListener('click',function(event){if(event.target.tagName!=='A')radio.checked=true;});});
all(section,'input[type=file]').forEach(function(input){var list=document.createElement('ul');list.className='file-list';list.setAttribute('aria-live','polite');input.insertAdjacentElement('afterend',list);input.addEventListener('change',function(){list.innerHTML='';Array.prototype.forEach.call(input.files,function(file){var item=document.createElement('li');item.textContent=file.name+' · '+(file.size/1048576).toFixed(1)+' MB'+(file.size>max?' · too large':'');if(file.size>max)item.className='bad';list.appendChild(item);});});});
var folder=document.getElementById('add-folder'),state=document.getElementById('add-folder-state');
function showSaved(){if(!folder||!state)return;var info=saved[folder.value];if(!folder.value||!info){state.textContent='';return;}state.textContent=(info.structure?'Already has a corporate structure: '+info.structure+'.':'No corporate structure yet.')+(info.supporting.length?' Supporting files: '+info.supporting.join(', ')+'.':'');}
if(folder){folder.addEventListener('change',showSaved);showSaved();}
function problem(form){var picked=files(form),big=picked.filter(function(file){return file.size>max;})[0];
if(big)return big.name+' is over the '+Math.floor(max/1048576)+' MB limit.';
var structure=form.querySelector('input[name=structure]');if(structure&&structure.files.length&&!/\.json$/i.test(structure.files[0].name))return 'The corporate-structure file must be a .json file.';
if(form.id==='fetch-form'&&!form.querySelector('input[name=accession]:checked'))return 'Pick the fiscal year to download.';
if(form.id==='import-form'){if(!Array.prototype.some.call(form.querySelector('#files').files,function(file){return /\.(zip|htm|html|xhtml)$/i.test(file.name);}))return 'Choose the filing itself: a .zip from EDGAR, or the 10-K .htm with its .xsd and linkbase files.';
var email=form.querySelector('[name=user_agent]').value.trim(),accession=form.querySelector('[name=accession]').value.trim(),date=form.querySelector('[name=filing_date]').value;
if(!email&&!secEnv&&!(accession&&date))return 'Enter your email so the accession and filing date can be looked up on SEC EDGAR, or type both the accession and the filing date.';}
if(form.id==='add-form'){if(!folder.value)return 'Choose which saved 10-K to add the files to.';if(!picked.length)return 'Choose at least one file to add.';
var info=saved[folder.value],replace=form.querySelector('[name=replace_structure]');if(structure.files.length&&info&&info.structure&&!replace.checked)return 'This 10-K already has a corporate structure ('+info.structure+'). Tick "replace it" to swap it.';}
return '';}
all(section,'form').forEach(function(form){form.addEventListener('submit',function(event){var box=form.querySelector('.form-problem'),message=problem(form);
if(message){event.preventDefault();if(box){box.textContent=message;box.hidden=false;box.scrollIntoView({block:'center'});}return;}
if(box)box.hidden=true;var button=event.submitter||form.querySelector('button[type=submit]');if(button&&button.dataset.busy){button.dataset.label=button.textContent;button.textContent=button.dataset.busy;button.disabled=true;}form.setAttribute('aria-busy','true');});});
window.addEventListener('pageshow',function(event){if(!event.persisted)return;all(section,'button[data-label]').forEach(function(button){button.textContent=button.dataset.label;button.disabled=false;});all(section,'form[aria-busy]').forEach(function(form){form.removeAttribute('aria-busy');});});})();</script>
</body></html>