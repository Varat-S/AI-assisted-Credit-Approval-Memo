<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>New Analysis · Setup</title>{% include 'workspace_style.html.j2' %}<style>.manage-filings{grid-column:1/-1}.manage-filings>summary{font-weight:600;cursor:pointer}.manage-filings[open]>summary{margin-bottom:20px}</style></head><body>
{% set active='new' %}{% include 'analysis_nav.html.j2' %}<header class="setup-header"><span class="eyebrow">New Analysis</span><h1>Set up your analysis</h1><p>Choose the scope and safeguards for your credit analysis.</p><ol class="stepper" aria-label="Analysis steps"><li aria-current="step"><span class="step-number">1</span>Setup</li><li aria-disabled="true"><span class="step-number">2</span>Execution</li><li aria-disabled="true"><span class="step-number">3</span>Review</li></ol></header>
<main>{% if errors %}<div class="setup-errors" role="alert"><strong>Setup needs attention</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% elif checked %}<div class="setup-checked" role="status">Configuration checked. Your selections map to the existing analysis workflow. No analysis has been started.</div>{% endif %}
{% if notice %}<div class="setup-checked" role="status">{{ notice }}</div>{% endif %}
<div class="setup-layout"><section class="setup-panel"><h2>Analysis configuration</h2><form method="get" action="/analysis/new" id="setup-form"><input type="hidden" name="submission_key" value="{{ submission_key }}"><input type="hidden" name="check" value="1">
<label for="company">Hospital company</label><select id="company" name="company" required>{% for company in companies %}<option value="{{ company.id }}"{% if company.id == values.company %} selected{% endif %}>{{ company.label }}</option>{% endfor %}</select><p class="hint">Every 10-K filing folder in <code>edgar_filings/</code> is listed.</p>
<fieldset><legend>Analysis scope</legend><label class="choice"><input type="radio" name="sections" value="both"{% if values.sections == 'both' %} checked{% endif %}><span><strong>Business + Financial Overview</strong><small>Prepare both sections using the same evidence package.</small></span></label><label class="choice"><input type="radio" name="sections" value="bo"{% if values.sections == 'bo' %} checked{% endif %}><span><strong>Business Overview Only</strong><small>Business analysis, cross-module synthesis and independent challenge.</small></span></label><label class="choice"><input type="radio" name="sections" value="fo"{% if values.sections == 'fo' %} checked{% endif %}><span><strong>Financial Overview Only</strong><small>Financial pre-checks, ratios and scoring from the filing's Inline XBRL.</small></span></label></fieldset>
<fieldset><legend>Validation safeguards</legend><label class="choice"><input type="radio" name="validation_mode" value="standard"{% if values.validation_mode == 'standard' %} checked{% endif %}><span><strong>Standard Mode — Safeguards On</strong><small>Existing evidence-grounding and deterministic validations remain enforced.</small></span></label><label class="choice"><input type="radio" name="validation_mode" value="exploratory"{% if values.validation_mode == 'exploratory' %} checked{% endif %}><span><strong>Exploratory Mode — Safeguards Relaxed</strong><small>Record supported Business Overview validation findings in an advisory capacity.</small></span></label></fieldset>
<p class="hint">This setting applies to Business Overview only. Financial Overview checks, source provenance and integrity protections remain unchanged.</p>
<div class="mode-note" id="exploratory-note"{% if values.validation_mode != 'exploratory' %} hidden{% endif %}><strong>Exploratory, unvalidated output.</strong> Not eligible for final approval. Relaxing safeguards does not establish greater accuracy or usefulness.</div>
<details><summary>Advanced settings</summary><label for="cutoff">Evidence cutoff override (optional)</label><input id="cutoff" name="cutoff" value="{{ values.cutoff }}" placeholder="2025-03-31T23:59:59Z"><p class="hint">Include a timezone. Leave blank to retain the configured evidence cutoff.</p><label for="case_id">Case reference (optional)</label><input id="case_id" name="case_id" value="{{ values.case_id }}" placeholder="Use the existing company and filing reference"><p class="hint">Letters, numbers, underscores, dots and hyphens only.</p></details>
<div class="setup-actions"><button class="secondary-button" type="submit">Check setup</button><button class="primary-button" id="run-analysis" type="submit" formaction="/analysis/start" formmethod="post"{% if not execution_enabled %} disabled aria-disabled="true"{% endif %} aria-describedby="execution-note">Run Analysis</button></div><p class="execution-note" id="execution-note">Run Analysis starts paid AI processing. Checking this setup does not create a run or make a paid AI call. Provider access is checked again on submission.</p>
</form></section>

<aside class="evidence-panel" aria-label="Selected evidence package"><span class="eyebrow">Selected evidence</span>{% if selection %}<p class="evidence-name">{{ selection.company.label }}</p><span class="evidence-tag">FY{{ selection.evidence.report_date.year }} annual report</span><dl><dt>Financial reporting period</dt><dd>Year ended {{ selection.evidence.report_date.strftime('%d %B %Y') }}</dd><dt>Filing date</dt><dd>{{ selection.evidence.filing_date.strftime('%d %B %Y') }}</dd><dt>Evidence cutoff · UTC</dt><dd>{{ selection.evidence.cutoff.strftime('%d %b %Y, %H:%M:%S') }}</dd><dt>Evidence package</dt><dd>{{ selection.evidence.folder }}</dd><dt>Source identifier</dt><dd>{{ selection.evidence.accession }}</dd><dt>Annual report source</dt><dd>{{ selection.evidence.primary_document }}</dd><dt>Package sources</dt><dd>{{ selection.evidence.sources }} files</dd></dl>{% else %}<p class="evidence-name">Evidence unavailable</p><p class="hint">The required company package must be restored or corrected before it can be used.</p>{% endif %}
<div class="readiness">{% if providers.configured %}<strong>Provider settings present</strong>Live connectivity and credentials have not been tested. Readiness is checked again when you submit; model access is confirmed by execution.{% else %}<strong>Provider configuration needed</strong>Review the setup message before live execution is connected.{% endif %}</div></aside>
<details class="setup-panel manage-filings"{% if filings_open %} open{% endif %}><summary>Add Company / Manage Filings</summary><section id="add-evidence"><h2>Add a 10-K</h2><p class="hint">Download a filing from SEC EDGAR, or upload its files. It is saved to <code>edgar_filings/</code> with its <code>bundle.json</code> and <code>company.json</code>, then appears in the company list above.</p>
<form method="get" action="/analysis/new/reports#add-evidence"><fieldset><legend>Download from SEC EDGAR</legend>
<label for="user_agent">Your email</label><input id="user_agent" name="user_agent" type="email" autocomplete="email" placeholder="you@example.com" value="{{ edgar.user_agent or '' }}"{% if not sec_env %} required{% endif %}><p class="hint">SEC EDGAR asks requests to identify a contact. {% if sec_env %}Leave blank to use the contact configured on the server.{% else %}No API key is needed. Used only for this request; it is not saved.{% endif %}</p>
<label for="ticker">Ticker</label><input id="ticker" name="ticker" required placeholder="e.g. HCA" value="{{ edgar.ticker or '' }}">
<label class="choice"><input type="checkbox" name="amendments" value="1"{% if edgar.amendments %} checked{% endif %}><span><small>Include amended 10-Ks (10-K/A)</small></span></label>
<div class="setup-actions"><button class="secondary-button" type="submit">Find 10-Ks</button></div></fieldset></form>
{% if reports %}<form method="post" action="/analysis/new/fetch"><fieldset><legend>{{ edgar.company.name }} ({{ edgar.company.ticker }}): choose a 10-K to download</legend><input type="hidden" name="ticker" value="{{ edgar.company.ticker }}"><input type="hidden" name="user_agent" value="{{ edgar.user_agent or '' }}">
<div class="table-wrap"><table><thead><tr><th></th><th>Fiscal year</th><th>Form</th><th>Period ending</th><th>Filed</th><th>Proxy</th><th></th></tr></thead><tbody>{% set ns = namespace(first=true) %}
{% for r in reports %}{% set usable = not r.problem and not r.downloaded %}<tr><td><input type="radio" name="accession" id="acc-{{ loop.index }}" value="{{ r.accession }}"{% if not usable %} disabled{% elif ns.first %} checked{% set ns.first = false %}{% endif %}></td><td><label for="acc-{{ loop.index }}">FY{{ r.fiscal_year }}</label></td><td>{{ r.form }}</td><td>{{ r.report_date }}</td><td>{{ r.filing_date }}</td><td>{{ r.proxy or '—' }}</td><td>{% if r.downloaded %}already in <code>edgar_filings/{{ r.folder }}</code>{% elif r.problem %}{{ r.problem }}{% endif %}</td></tr>{% endfor %}</tbody></table></div>
<label class="choice"><input type="checkbox" name="with_proxy" value="1" checked><span><small>Also download the proxy statement (better management, governance and related-party evidence)</small></span></label>
<div class="setup-actions"><button class="primary-button" type="submit"{% if ns.first %} disabled{% endif %}>Download the selected 10-K</button></div></fieldset></form>{% endif %}
<form method="post" action="/analysis/new/import" enctype="multipart/form-data"><fieldset><legend>Upload a filing's files</legend>
<label for="files">Inline XBRL 10-K (.htm), its .xsd and linkbases, or a .zip</label><input id="files" name="files" type="file" multiple required accept=".zip,.htm,.html,.xhtml,.xml,.xsd,.json">
<label for="import-accession">Accession</label><input id="import-accession" name="accession" placeholder="0001193125-26-044769" value="{{ edgar.accession or '' }}">
<label for="filing_date">Filing date</label><input id="filing_date" name="filing_date" type="date" value="{{ edgar.filing_date or '' }}">
<p class="hint">Optional: the accession and date are looked up and checked on SEC EDGAR when an email is entered{% if sec_env %} (or configured on the server){% endif %}; otherwise they are recorded as declared by you.</p>
<label for="import-user-agent">Your email (optional)</label><input id="import-user-agent" name="user_agent" type="email" placeholder="you@example.com" value="{{ edgar.user_agent or '' }}">
<label for="import-ticker">Ticker (optional)</label><input id="import-ticker" name="ticker" value="{{ edgar.import_ticker or '' }}">
<div class="setup-actions"><button class="secondary-button" type="submit">Upload</button></div></fieldset></form></section></details></div></main>
<script>(function(){const note=document.getElementById('exploratory-note');document.querySelectorAll('input[name="validation_mode"]').forEach(function(input){input.addEventListener('change',function(){note.hidden=document.querySelector('input[name="validation_mode"]:checked').value!=='exploratory';});});})();document.getElementById('company').addEventListener('change',function(){var form=document.getElementById('setup-form'),q=new URLSearchParams();q.set('company',this.value);['sections','validation_mode'].forEach(function(n){var c=form.querySelector('input[name="'+n+'"]:checked');if(c)q.set(n,c.value);});window.location.href='/analysis/new?'+q.toString();});document.getElementById('setup-form').addEventListener('submit',function(event){if(event.submitter && event.submitter.id==='run-analysis'){this.action='/analysis/start';this.method='post';event.submitter.disabled=true;event.submitter.textContent='Starting analysis…';}});</script>
</body></html>