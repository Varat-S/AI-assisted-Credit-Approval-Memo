<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>New Analysis · Setup</title>{% include 'workspace_style.html.j2' %}</head><body>
{% set active='new' %}{% include 'analysis_nav.html.j2' %}<header class="setup-header"><span class="eyebrow">New Analysis</span><h1>Set up your analysis</h1><p>Choose the scope and safeguards for your credit analysis.</p><ol class="stepper" aria-label="Analysis steps"><li aria-current="step"><span class="step-number">1</span>Setup</li><li aria-disabled="true"><span class="step-number">2</span>Execution</li><li aria-disabled="true"><span class="step-number">3</span>Review</li></ol></header>
<main>{% if errors %}<div class="setup-errors" role="alert"><strong>Setup needs attention</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% elif checked %}<div class="setup-checked" role="status">Configuration checked. Your selections map to the existing analysis workflow. No analysis has been started.</div>{% endif %}
{% if notice %}<div class="setup-checked" role="status">{{ notice }}</div>{% endif %}
<div class="setup-layout"><section class="setup-panel"><h2>Analysis configuration</h2><form method="get" action="/analysis/new" id="setup-form"><input type="hidden" name="submission_key" value="{{ submission_key }}"><input type="hidden" name="check" value="1">
<label for="company">Hospital company</label><select id="company" name="company" required>{% for company in companies %}<option value="{{ company.id }}"{% if company.id == values.company %} selected{% endif %}>{{ company.label }}</option>{% endfor %}</select><p class="hint">Select a company to analyze its configured annual report.</p>
<fieldset><legend>Analysis scope</legend><label class="choice"><input type="radio" name="sections" value="both"{% if values.sections == 'both' %} checked{% endif %}><span><strong>Business + Financial Overview</strong><small>Prepare both sections using the same evidence package.</small></span></label><label class="choice"><input type="radio" name="sections" value="bo"{% if values.sections == 'bo' %} checked{% endif %}><span><strong>Business Overview Only</strong><small>Specialist analysis and source-only Competitive Positioning selection.</small></span></label><label class="choice"><input type="radio" name="sections" value="fo"{% if values.sections == 'fo' %} checked{% endif %}><span><strong>Financial Overview Only</strong><small>Financial pre-checks, ratios and scoring from the filing's Inline XBRL.</small></span></label></fieldset>
<fieldset><legend>Validation safeguards</legend><label class="choice"><input type="radio" name="validation_mode" value="standard"{% if values.validation_mode == 'standard' %} checked{% endif %}><span><strong>Standard Mode — Safeguards On</strong><small>Existing evidence-grounding and deterministic validations remain enforced.</small></span></label><label class="choice"><input type="radio" name="validation_mode" value="exploratory"{% if values.validation_mode == 'exploratory' %} checked{% endif %}><span><strong>Exploratory Mode — Safeguards Relaxed</strong><small>Specialist validation findings are advisory. Finding selection and source integrity remain enforced.</small></span></label></fieldset>
<p class="hint">This setting applies to Business Overview only. Financial Overview checks, source provenance and integrity protections remain unchanged.</p>
<div class="mode-note" id="exploratory-note"{% if values.validation_mode != 'exploratory' %} hidden{% endif %}><strong>Exploratory, unvalidated output.</strong> Not eligible for final approval. Relaxing safeguards does not establish greater accuracy or usefulness.</div>
<details><summary>Advanced settings</summary><label for="cutoff">Evidence cutoff override (optional)</label><input id="cutoff" name="cutoff" value="{{ values.cutoff }}" placeholder="2025-03-31T23:59:59Z"><p class="hint">Include a timezone. Leave blank to retain the configured evidence cutoff.</p><label for="case_id">Case reference (optional)</label><input id="case_id" name="case_id" value="{{ values.case_id }}" placeholder="Use the existing company and filing reference"><p class="hint">Letters, numbers, underscores, dots and hyphens only.</p></details>
<div class="setup-actions"><button class="secondary-button" type="submit">Check setup</button><button class="primary-button" id="run-analysis" type="submit" formaction="/analysis/start" formmethod="post"{% if not execution_enabled %} disabled aria-disabled="true"{% endif %} aria-describedby="execution-note">Run Analysis</button></div><p class="execution-note" id="execution-note">Run Analysis starts paid AI processing. Checking this setup does not create a run or make a paid AI call. Provider access is checked again on submission.</p>
</form></section>

<aside class="evidence-panel" aria-label="Selected evidence package"><span class="eyebrow">Selected evidence</span>{% if selection %}<p class="evidence-name">{{ selection.company.label }}</p><span class="evidence-tag">FY{{ selection.evidence.report_date.year }} annual report</span><dl><dt>Financial reporting period</dt><dd>Year ended {{ selection.evidence.report_date.strftime('%d %B %Y') }}</dd><dt>Filing date</dt><dd>{{ selection.evidence.filing_date.strftime('%d %B %Y') }}</dd><dt>Evidence cutoff · UTC</dt><dd>{{ selection.evidence.cutoff.strftime('%d %b %Y, %H:%M:%S') }}</dd><dt>Evidence package</dt><dd>{{ selection.evidence.folder }}</dd><dt>Source identifier</dt><dd>{{ selection.evidence.accession }}</dd><dt>Annual report source</dt><dd>{{ selection.evidence.primary_document }}</dd><dt>Package sources</dt><dd>{{ selection.evidence.sources }} files</dd></dl>{% else %}<p class="evidence-name">Evidence unavailable</p><p class="hint">The required company package must be restored or corrected before it can be used.</p>{% endif %}
<div class="readiness">{% if providers.configured %}<strong>Provider settings present</strong>Live connectivity and credentials have not been tested. Readiness is checked again when you submit; model access is confirmed by execution.{% else %}<strong>Provider configuration needed</strong>Review the setup message before live execution is connected.{% endif %}</div></aside>
<div class="file-tools">
<section class="setup-panel file-card" id="add-evidence"><h2>Download Files</h2>
<p class="file-intro">Download the configured companies’ 10-K filings and supporting documents directly from SEC EDGAR. Files are saved to the application’s filing library automatically.</p>
<div class="setup-actions"><button class="secondary-button" id="download-files" type="button">Download Files</button></div>
<p class="hint" id="download-location">Saved directly into the application’s filing folder.</p>
<p class="hint">Includes HCA’s FY2025 filing. A contact email is requested only when needed. No SEC API key is required.</p>
<p id="download-status" role="status" aria-live="polite"></p><ul id="download-results"></ul>
</section>
<section class="setup-panel file-card" id="corporate-upload"><h2>Upload Documents</h2>
<p class="file-intro">Upload a corporate structure JSON for the company selected above. The file supplies the ownership and guarantor information used by Module 3.</p>
<form id="structure-form" enctype="multipart/form-data">
<input type="hidden" name="company" value="{{ values.company }}">
<input id="structure-file" name="file" type="file" accept=".json,application/json" hidden>
<div class="setup-actions"><button class="secondary-button" id="choose-structure" type="button">Choose File</button><button class="secondary-button" id="upload-structure" type="submit" disabled>Upload</button></div>
<p class="hint" id="structure-filename">No file selected.</p>
</form>
<p class="hint" id="structure-company">{% if selection %}For {{ selection.company.label }} · FY{{ selection.evidence.report_date.year }}. Existing versions are backed up when replaced.{% else %}Download a filing and select its company before uploading.{% endif %}</p>
<p id="structure-status" role="status" aria-live="polite"></p>
</section></div>
<dialog id="sec-contact-dialog" aria-labelledby="sec-contact-title"><form id="sec-contact-form"><h2 id="sec-contact-title">SEC download contact</h2><p>Enter a contact email to identify this request to SEC EDGAR. It is used for this download and is not saved to your settings.</p><label for="sec-contact">Email address</label><input id="sec-contact" type="email" autocomplete="email" required placeholder="you@example.com"><div class="setup-actions"><button class="secondary-button" id="cancel-contact" type="button">Cancel</button><button class="primary-button" type="submit">Download Files</button></div></form></dialog>
</div></main>
<script>(function(){const note=document.getElementById('exploratory-note');document.querySelectorAll('input[name="validation_mode"]').forEach(function(input){input.addEventListener('change',function(){note.hidden=document.querySelector('input[name="validation_mode"]:checked').value!=='exploratory';});});})();document.getElementById('company').addEventListener('change',function(){var form=document.getElementById('setup-form'),q=new URLSearchParams();q.set('company',this.value);['sections','validation_mode'].forEach(function(n){var c=form.querySelector('input[name="'+n+'"]:checked');if(c)q.set(n,c.value);});window.location.href='/analysis/new?'+q.toString();});document.getElementById('setup-form').addEventListener('submit',function(event){if(event.submitter && event.submitter.id==='run-analysis'){this.action='/analysis/start';this.method='post';event.submitter.disabled=true;event.submitter.textContent='Starting analysis…';}});
(function(){
const download=document.getElementById('download-files'),status=document.getElementById('download-status'),results=document.getElementById('download-results'),dialog=document.getElementById('sec-contact-dialog');
async function refreshSelection(){
 const select=document.getElementById('company'),q=new URLSearchParams({company:select.value,sections:document.querySelector('input[name="sections"]:checked').value,validation_mode:document.querySelector('input[name="validation_mode"]:checked').value});
 const response=await fetch('/analysis/new?'+q),doc=new DOMParser().parseFromString(await response.text(),'text/html');
 select.replaceChildren(...Array.from(doc.getElementById('company').options).map(o=>o.cloneNode(true)));
 const aside=doc.querySelector('.evidence-panel');if(aside)document.querySelector('.evidence-panel').replaceWith(aside);
 document.querySelector('#structure-form input[name="company"]').value=select.value;
 document.getElementById('structure-company').textContent=doc.getElementById('structure-company').textContent;
 const run=doc.getElementById('run-analysis');document.getElementById('run-analysis').disabled=run.disabled;
 const previous=document.querySelector('.setup-errors'),updated=doc.querySelector('.setup-errors');
 if(previous){if(updated)previous.replaceWith(updated);else previous.remove();}else if(updated)document.querySelector('.setup-layout').before(updated);
}
async function downloadFiles(contact){
 download.disabled=true;download.textContent='Downloading…';status.textContent='Checking filings and downloading missing documents from SEC…';results.replaceChildren();
 try{
 const form=new FormData();if(contact)form.set('user_agent',contact);
 const response=await fetch('/analysis/new/download-files',{method:'POST',body:form,headers:{'X-Requested-With':'setup-files'}}),data=await response.json();
 if(data.needs_contact){status.textContent='A contact email is needed to download from SEC.';dialog.showModal();document.getElementById('sec-contact').focus();return;}
 if(!response.ok)throw new Error(data.detail||'Download failed.');
 status.textContent=data.message;
 data.results.forEach(item=>{const row=document.createElement('li');row.textContent=item.folder+': '+item.status+(item.error?' — '+item.error:'');results.appendChild(row);});
 await refreshSelection();
 }catch(error){status.textContent=error.message||'Unable to download files. Please try again.';}
 finally{download.disabled=false;download.textContent='Download Files';}
}
download.addEventListener('click',()=>downloadFiles(''));
document.getElementById('cancel-contact').addEventListener('click',()=>{dialog.close();document.getElementById('sec-contact').value='';status.textContent='Download cancelled.';});
dialog.addEventListener('cancel',()=>{document.getElementById('sec-contact').value='';status.textContent='Download cancelled.';});
document.getElementById('sec-contact-form').addEventListener('submit',event=>{event.preventDefault();const contact=document.getElementById('sec-contact').value;dialog.close();document.getElementById('sec-contact').value='';downloadFiles(contact);});
const input=document.getElementById('structure-file'),upload=document.getElementById('upload-structure'),uploadStatus=document.getElementById('structure-status');
document.getElementById('choose-structure').addEventListener('click',()=>input.click());
input.addEventListener('change',()=>{document.getElementById('structure-filename').textContent=input.files[0]?.name||'No file selected.';upload.disabled=!input.files.length;uploadStatus.textContent='';});
document.getElementById('structure-form').addEventListener('submit',async function(event){
 event.preventDefault();if(!input.files.length)return;upload.disabled=true;upload.textContent='Uploading…';uploadStatus.textContent='Validating corporate structure…';
 try{const response=await fetch('/analysis/new/corporate-structure',{method:'POST',body:new FormData(this),headers:{'X-Requested-With':'setup-files'}}),data=await response.json();if(!response.ok)throw new Error(data.detail||'Upload failed.');uploadStatus.textContent=data.message+' Data status: '+data.data_status+(data.simulated?' — simulated example, not verified corporate information.':'');input.value='';document.getElementById('structure-filename').textContent='No file selected.';}
 catch(error){uploadStatus.textContent=error.message||'Unable to upload this file.';}
 finally{upload.disabled=!input.files.length;upload.textContent='Upload';}
});
})();
</script>
</body></html>