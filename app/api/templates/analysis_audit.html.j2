<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audit &amp; Review · Credit Memo</title>{% include 'workspace_style.html.j2' %}{% include 'analysis_memo_style.html.j2' %}</head><body>{% set active='memos' %}{% include 'analysis_nav.html.j2' %}
{% macro details(label,value) %}<details><summary>{{ label }}</summary>{% if value is undefined or value is none or value == [] or value == {} or value == '' %}<p class="memo-empty">Not recorded</p>{% else %}<pre>{{ value if value is string else value|tojson(indent=2) }}</pre>{% endif %}</details>{% endmacro %}
{% macro outputs(records) %}{% for record in records %}<div class="audit-record"><h3>{{ record.agent_id }} · {{ record.status }}</h3><p class="record-id">{{ record.run_id }} · {{ record.created_at }}</p>{% if record.error %}<p class="notice-warning">{{ record.error }}</p>{% endif %}{{ details('Raw model output',record.raw) }}{{ details('Parsed model output',record.parsed) }}{{ details('Recorded validation detail',record.detail) }}{{ details('Execution provenance',{'parent_run_ids':record.parent_run_ids,'input_evidence_ids':record.evidence_ids,'reused_from_cache':record.reused_from_cache,'usage':record.usage}) }}{% if record.rerun_reason %}<p>Retry / remediation: {{ record.rerun_reason }}</p>{% endif %}</div>{% else %}<p class="memo-empty">Execution output: Not recorded</p>{% endfor %}{% endmacro %}
<header class="setup-header"><span class="eyebrow">Credit Memos · Selected run</span><h1>Audit &amp; Review</h1><p>{{ job.metadata.company or job.folder }} · {{ job.metadata.reporting_period or 'Period not recorded' }}</p></header><main>
{% if job.metadata.test_state or (view.memo and view.memo.run.execution_mode == 'offline_simulation') %}<p class="notice-warning"><strong>Synthetic / offline record.</strong> {{ job.metadata.test_state or 'Scripted outputs; this is not a live analysis.' }}</p>{% endif %}
<div class="memo-meta"><span>Execution: {{ job.execution_status|title }}</span><span>Credit memo: {{ view.governance }}</span><span>{{ 'Standard' if job.bo_validators else 'Exploratory · approval prohibited' }}</span></div><p class="record-id">Selected job {{ job.job_id }}{% if view.bo %} · BO {{ view.bo.analysis_run_id }}{% endif %}{% if view.fo %} · FO {{ view.fo.run_id }}{% endif %}</p>
<div class="memo-actions"><a class="memo-button primary" href="/analysis/{{ job.job_id }}/review">Back to memo</a><a class="memo-button" href="/credit-memos">Credit Memos</a>{% if view.bo and view.memo and view.audit %}<a class="memo-button" href="/cases/{{ job.case_id }}/bo.html?analysis_run_id={{ view.bo.analysis_run_id }}">Existing BO human review</a>{% endif %}{% if view.fo %}<a class="memo-button" href="/cases/{{ job.case_id }}/fo.html?run_id={{ view.fo.run_id }}">Existing FO human review</a>{% endif %}</div>
<p class="technical-note">This workspace is read-only. Review decisions use the existing run-specific services and eligibility safeguards.</p>
<nav class="audit-tabs" aria-label="Audit sections"><a href="#specialists">1. Specialist Findings</a><a href="#validators">2. Validator Decisions</a><a href="#synthesizer">3. Cross-Module Synthesizer</a><a href="#challenger">4. Independent Challenger</a><a href="#evidence">5. Evidence &amp; Citations</a></nav>
<article class="memo-paper">
<section id="specialists"><h2>1. Specialist Findings</h2>{% for finding in audit.hypotheses %}<div class="audit-record" id="{{ finding.anchor }}"><h3>{{ finding.hypothesis_id }}</h3>{% for version in finding.versions %}<div id="{{ version.version_anchor }}"><p class="technical-note">{{ version.agent_id }} · {{ version.disposition }} · {{ version.admissibility }} · record state: {{ version.acceptance_state }}</p><dl><dt>Original model wording</dt><dd>{{ version.original_claim }}</dd><dt>Validator-recorded wording</dt><dd>{{ version.claim or 'Not recorded' }}</dd></dl>{% for eid in (version.supporting_evidence_ids or []) + (version.contradicting_evidence_ids or []) %}<a class="audit-link" href="#{{ anchor('evidence',eid) }}">{{ eid }}</a> {% endfor %}{{ details('Recorded finding, qualifications and all version fields',version) }}</div>{% endfor %}</div>{% else %}<p class="memo-empty">Specialist hypotheses: Not recorded</p>{% endfor %}
{{ details('Module 3 and debt specialist artefacts',audit.modules) }}{{ details('Recorded management judgments',audit.management_claims) }}{{ outputs(audit.specialists) }}</section>
<section id="validators"><h2>2. Validator Decisions</h2><p class="technical-note">Original responses and validator-recorded findings are distinct. Accepted record versions can contain rejected or audit-only hypotheses.</p>{% for finding in audit.hypotheses %}{% for version in finding.versions %}<div class="audit-record"><h3><a href="#{{ finding.anchor }}">{{ finding.hypothesis_id }}</a> · {{ version.disposition }}</h3><p>{{ version.validator_id or 'Validator not recorded' }} {{ version.validator_version or '' }} · {{ version.admissibility }}</p>{{ details('Validation reasons and review flags',{'notes':version.validation_notes or [],'review_flags':version.review_flags or [],'model_stated':version.model_stated or {},'presentation_basis':version.presentation_basis or {},'recovery':version.recovery or []}) }}</div>{% endfor %}{% endfor %}
{{ details('Agent validation, adjustments, coverage and reconciliation',audit.validator_records) }}{{ outputs(audit.validators) }}
{% if view.financial %}<h3>Financial Overview checks &amp; analyst decisions</h3>{{ details('Recorded pre-checks',view.financial.prechecks) }}{{ details('Recorded analyst decisions',view.financial.decisions) }}{% endif %}</section>
<section id="synthesizer"><h2>3. Cross-Module Synthesizer</h2>{% if view.reason %}<p class="notice-warning">{{ view.reason }}</p>{% endif %}{{ outputs(audit.synthesizers) }}{{ details('Synthesis validation feedback and attempts',audit.synthesis_history) }}
{% for conclusion in audit.conclusions %}<div class="audit-record"><h3>Conclusion {{ conclusion.conclusion_id }}</h3><p>{{ conclusion.acceptance_state }} · challenge state: {{ conclusion.challenge_status or 'Not recorded' }}</p>{{ details('Recorded synthesis conclusion (validation state above)',conclusion.payload) }}</div>{% else %}<p class="memo-empty">Validated synthesis: Not recorded</p>{% endfor %}
<h3>Synthesized claims and supporting hypotheses</h3>{% for claim in audit.claims %}<div class="audit-record" id="{{ claim.anchor }}"><strong>{{ claim.claim_id }}</strong><p>{{ claim.text }}</p><p class="technical-note">{{ claim.category|replace('_',' ')|title }} · {{ claim.record_state }} · conclusion {{ claim.conclusion_id }}</p>{% if claim.automatic_coverage %}<p class="technical-note">Automatic specialist coverage copy; kept in Audit &amp; Review rather than the primary memo.</p>{% else %}<p class="technical-note">Individual claim origin: not separately classified by recorded coverage adjustments.</p>{% endif %}{% for hypothesis in claim.hypotheses %}{% if hypothesis.href %}<a class="audit-link" href="{{ hypothesis.href }}">{{ hypothesis.hypothesis_id }}</a>{% else %}<span class="technical-note">{{ hypothesis.hypothesis_id }} · supporting record not recorded</span>{% endif %} {% endfor %}{% for pid in claim.parameter_result_ids or [] %}{% if audit.calculations|selectattr('parameter_result_id','equalto',pid)|list %}<a class="audit-link" href="#{{ anchor('calculation',pid) }}">{{ pid }}</a>{% else %}<span class="technical-note">{{ pid }} · calculation not recorded</span>{% endif %}{% endfor %}{% for eid in claim.evidence_ids or [] %}<a class="audit-link" href="#{{ anchor('evidence',eid) }}">{{ eid }}</a> {% endfor %}</div>{% else %}<p class="memo-empty">Individual synthesized claims: Not recorded</p>{% endfor %}</section>
<section id="challenger"><h2>4. Independent Challenger</h2>{{ outputs(audit.challengers) }}{% set rounds=audit.challenge.rounds or [] %}{% if rounds is string %}<p>{{ rounds|replace('_',' ')|title }}</p>{% else %}{% for round in rounds %}<div class="audit-record"><h3>Round {{ round.round }} · {{ round.status }}</h3><p>Recorded outcome: {{ round.outcome or 'Not recorded' }}</p><p>{{ round.summary or 'Summary: Not recorded' }}</p>{% for finding in round.findings or [] %}<p><strong>{{ finding.severity|title }}</strong> · {{ finding.reason }}</p><p class="technical-note">Affected claim: {% if finding.target_href %}<a href="{{ finding.target_href }}">{{ finding.target }}</a>{% else %}{{ finding.target or 'Not recorded' }}{% endif %} · Reanalysis requested: {{ finding.requires_reanalysis }}</p>{% endfor %}{{ details('Challenge findings, affected claims and remediation decision',round) }}</div>{% else %}<p class="memo-empty">Independent challenge execution: Not recorded</p>{% endfor %}{% endif %}{{ details('All recorded challenge findings',audit.challenge.recorded_findings) }}{{ details('Bounded remediation and final outcome',{'remediation':audit.remediation,'final_conclusion':audit.record}) }}</section>
<section id="evidence"><h2>5. Evidence &amp; Citations</h2><p class="technical-note">Citation existence, quotation verification and analytical support are separate. A citation or retained quotation alone does not prove the analysis. “Not recorded” means the selected run has no explicit result for that field; these checks are not rerun by the UI.</p>
{% for source in audit.evidence %}<div class="audit-record" id="{{ source.anchor }}"><h3>{{ source.filename or source.evidence_id }}</h3><p class="record-id">{{ source.evidence_id }} · {{ source.section or '' }} {{ source.location or '' }}{% if source.page %} · Page {{ source.page }}{% endif %}</p><p class="technical-note">Citation existence: {{ source.existence }}</p>{% if source.href %}<a class="audit-link" href="{{ source.href }}" target="_blank" rel="noopener noreferrer">Open recorded source</a>{% endif %}{% if source.excerpt %}{{ details('Recorded source passage',source.excerpt) }}{% endif %}{% for quote in source.quotes %}<blockquote>{{ quote.quote }}</blockquote><p class="technical-note">Quotation verification: {{ quote.verification }} · Analytical entailment verification: {{ quote.entailment }} · Finding disposition: {{ quote.finding_disposition }} · {{ quote.admissibility }} · Evidence basis: {{ quote.evidence_basis }}</p><a class="audit-link" href="#{{ anchor('finding',quote.hypothesis_id) }}">{{ quote.hypothesis_id }}</a>{% else %}<p class="memo-empty">Quotation verification: Not recorded · Analytical entailment verification: Not recorded. See linked findings for validator decisions.</p>{% endfor %}</div>{% else %}<p class="memo-empty">Evidence and citation records: Not recorded</p>{% endfor %}
<h3>Parameters &amp; calculation provenance</h3>{{ details('Recorded parameter results',audit.parameters) }}{% for calculation in audit.calculations %}<div class="audit-record" id="{{ calculation.anchor }}">{{ details(calculation.label or calculation.parameter_result_id,calculation) }}</div>{% else %}<p class="memo-empty">Calculation traces: Not recorded</p>{% endfor %}{{ details('Recorded document identities',audit.documents) }}{{ details('Rejected sources retained in the audit',audit.rejected_sources) }}</section>
</article></main></body></html>
