<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Credit view</title>{% include 'browser_style.html.j2' %}
{% include 'credit_style.html.j2' %}</head>
<body>
{% from 'credit_macros.html.j2' import usd, st, sc with context %}
{% set fo, bo, rms = view.fo, view.bo, view.rms %}{% set r = rms.latest %}{% set rec = rms.record %}
{% set fo_run = fo.run_id if fo else '' %}{% set bo_run = bo.analysis_run_id if bo else '' %}
<header><span class="badge">Business Overview + Financial Overview + Risk Mitigation &amp; Structuring</span>
<h1>{{ (fo.entity_name if fo else none) or view.case_id }}: credit view</h1>
<p class="subtle">Case <code>{{ view.case_id }}</code>{% if fo and fo.period_end %} · period ending {{ fo.period_end }}{% endif %}. Decisions made on this page are recorded like those on the BO and FO workbenches, and RMS is re-assessed straight after each one, with the last requested loan.</p>
{% set bo_link = '/cases/' ~ view.case_id ~ '/bo.html?' ~ {'analysis_run_id': bo_run, 'credit': 1, 'fo_run': fo_run}|urlencode %}
{% set fo_link = '/cases/' ~ view.case_id ~ '/fo.html?' ~ {'run_id': fo_run, 'credit': 1, 'bo_run': bo_run}|urlencode %}
<div class="actions"><a href="/credit-memos">All cases</a>{% if bo %}<a href="{{ bo_link }}">Business Overview workbench</a>{% endif %}{% if fo %}<a href="{{ fo_link }}">Financial Overview workbench</a>{% endif %}<a href="/run">Run BO and FO</a></div>
{% if view.fo_runs|length > 1 or view.bo_runs|length > 1 %}
<form method="get" action="/cases/{{ view.case_id }}/credit.html" class="grid" style="margin-top:14px">
<div><label for="fo_run_pick">FO run</label><select id="fo_run_pick" name="fo_run">{% for x in view.fo_runs %}<option value="{{ x.run_id }}"{% if x.run_id == fo_run %} selected{% endif %}>{{ x.run_id }} ({{ x.status|replace('_', ' ') }}, {{ x.started_at[:10] }})</option>{% endfor %}</select></div>
<div><label for="bo_run_pick">BO run</label><select id="bo_run_pick" name="bo_run">{% for x in view.bo_runs %}<option value="{{ x.analysis_run_id }}"{% if x.analysis_run_id == bo_run %} selected{% endif %}>{{ x.analysis_run_id }} ({{ x.human_review_status }}, {{ x.created_at[:10] }})</option>{% endfor %}</select></div>
<div class="buttons"><button type="submit">Show these runs</button></div></form>{% endif %}
</header>
<main>
{% if error %}<section><p class="notice" role="alert"><strong>{{ error }}</strong></p></section>{% endif %}
{% if notice %}<section><p class="notice" role="status">{{ notice }}</p></section>{% endif %}

{% include 'rms_verdict.html.j2' %}

<div class="panels">
<section id="bo" class="card"><h2>Business Overview</h2>
{% if bo %}
<dl class="facts">
<dt>Handoff</dt><dd>{{ st(bo.human_review_status) }}{% if bo.reviewer %} by {{ bo.reviewer }}{% endif %}{% if bo.reviewed_at %} ({{ bo.reviewed_at[:10] }}){% endif %}</dd>
<dt>Conclusion</dt><dd>{{ st(bo.conclusion_status) }}</dd>
<dt>M4 credit verdict</dt><dd>{% if bo.m4.present %}{{ st(bo.m4.verdict) }} · placement {{ (bo.m4.placement or '—')|replace('_', ' ') }}{% else %}<span class="warn">no Module 4 output</span>{% endif %}</dd>
{% if bo.m4.present %}<dt>M4 status</dt><dd>{{ st(bo.m4.status) }} · debt specialist {{ 'validated' if bo.m4.validated else 'not validated' }}</dd>
<dt>M4 total debt</dt><dd>{{ usd(bo.m4.total_debt_m) }} · refinancing distress events {{ bo.m4.distress_events if bo.m4.distress_events is not none else '—' }}</dd>{% endif %}
<dt>M3 structural findings</dt><dd>{% if bo.m3_findings %}{% for f in bo.m3_findings %}{{ f.finding_id }} ({{ f.dimension|replace('_', ' ') }}){% if not loop.last %}; {% endif %}{% endfor %}{% else %}none counted{% endif %}</dd>
<dt>Unresolved challenges</dt><dd>{{ bo.unresolved_challenges|length }}</dd>
</dl>
{% if bo.risks %}<p><strong>Material risks and weaknesses</strong></p><ul>{% for x in bo.risks %}<li>{{ x.title }} <small class="subtle">{{ x.claim_id }}</small></li>{% endfor %}</ul>{% endif %}
{% if bo.unproven_mitigants %}<p><strong>Unproven mitigants</strong></p><ul>{% for m in bo.unproven_mitigants %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
{% if bo.can_reject %}
<form method="post" action="/cases/{{ view.case_id }}/credit/bo/{{ bo_run }}/review" class="grid" id="bo-review-form">
<input type="hidden" name="fo_run" value="{{ fo_run }}">
<div><label for="bo_reviewer">Reviewer</label><input id="bo_reviewer" name="reviewer" required></div>
<div><label for="bo_reason">Reason</label><input id="bo_reason" name="reason" required></div>
{% if bo.unresolved_challenges %}<div class="buttons"><label style="font-weight:normal"><input type="checkbox" name="acknowledge_unresolved" value="true" style="width:auto"> I acknowledge the {{ bo.unresolved_challenges|length }} unresolved challenge(s); they stay recorded</label></div>{% endif %}
<div class="buttons">{% if bo.can_accept %}<button type="submit" name="decision" value="accept">Accept the Business Overview</button>{% endif %}<button type="submit" name="decision" value="reject">Reject</button></div>
</form>{% if not bo.can_accept %}<p class="notice">There is no validated conclusion to accept.</p>{% endif %}
{% endif %}
<p><a href="{{ bo_link }}">Open the full Business Overview (memo, agents, evidence)</a> <span class="subtle">· you can come back here</span></p>
{% else %}<p>No Business Overview run for this case.</p>{% endif %}
</section>

<section id="fo" class="card"><h2>Financial Overview</h2>
{% if fo %}
<dl class="facts">
<dt>Run</dt><dd>{{ st(fo.status) }} <code>{{ fo.run_id }}</code></dd>
<dt>Composite risk score</dt><dd>{% if fo.composite is not none %}<strong>{{ sc(fo.composite) }} ({{ fo.rating }})</strong>{% else %}not scored{% endif %}{% if fo.engine_composite != fo.composite %} <span class="subtle">· engine {{ sc(fo.engine_composite) }} ({{ fo.engine_rating }})</span>{% endif %}</dd>
<dt>Going concern</dt><dd>{{ st(fo.gc_status) }}</dd>
<dt>Covenants</dt><dd>{{ st(fo.covenant_status) }}</dd>
</dl>
<div class="table-wrap"><table><thead><tr><th>Measure</th><th>Weight</th><th>Engine</th><th>Now</th><th>Analyst</th></tr></thead><tbody>
{% for m in fo.measures %}<tr><td>{{ m.name }}</td><td class="num">{{ '{:g}'.format(m.weight) }}%</td><td class="num">{{ sc(m.engine) }}</td><td class="num"><strong>{{ sc(m.score) }}</strong></td><td>{% if m.decision %}{{ m.decision.decision }} by {{ m.decision.reviewer }}{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
<p class="subtle">Risk scores run 1 (lowest) to 10. The FO rating methodology is provisional.</p>
{% if fo.pending %}<h3>Waiting for an analyst ({{ fo.pending|length }})</h3>
{% for e in fo.pending %}<div class="escalation">
{% if e.type == 'measure_override' %}
<p><strong>{{ e.measure_name or e.measure|replace('_', ' ') }}</strong>: engine score {{ sc(e.engine_score) }}.{% if e.reason %} <span class="subtle">{{ e.reason }}</span>{% endif %}</p>
<form method="post" action="/cases/{{ view.case_id }}/credit/fo/{{ fo_run }}/override" class="grid fo-override-form">
<input type="hidden" name="measure" value="{{ e.measure }}"><input type="hidden" name="bo_run" value="{{ bo_run }}">
<div><label>Your score <small>(to override, 1-10)</small></label><input name="score" type="number" min="1" max="10" step="0.1"></div>
<div><label>Reviewer</label><input name="reviewer" required></div>
<div><label>Reason</label><input name="reason" required></div>
<div class="buttons"><button type="submit" name="decision" value="accept">Accept the engine's score</button><button type="submit" name="decision" value="override">Override</button></div>
</form>
{% else %}
<p><strong>Going-concern decision</strong>{% if e.reason %}: <span class="subtle">{{ e.reason }}</span>{% endif %}</p>
<form method="post" action="/cases/{{ view.case_id }}/credit/fo/{{ fo_run }}/review" class="grid fo-review-form">
<input type="hidden" name="bo_run" value="{{ bo_run }}">
<div><label>Reviewer</label><input name="reviewer" required></div>
<div><label>Reason</label><input name="reason" required></div>
<div class="buttons">{% if e.disagreement %}<button type="submit" name="decision" value="use_verified">Use the verified result</button>{% endif %}<button type="submit" name="decision" value="continue">Continue (going-concern fail stands)</button><button type="submit" name="decision" value="stop">Stop</button></div>
</form>
{% endif %}</div>{% endfor %}
{% endif %}
{% if fo.decisions %}<p><strong>Analyst decisions applied</strong></p><ul>{% for d in fo.decisions %}<li>{{ d }}</li>{% endfor %}</ul>{% endif %}
<p><a href="{{ fo_link }}">Open the full Financial Overview (scorecard, pre-checks, triggers, evidence)</a> <span class="subtle">· you can come back here</span></p>
{% else %}<p>No Financial Overview run for this case.</p>{% endif %}
</section>
</div>

{% include 'rms_detail.html.j2' %}
</main>
</body>
</html>
