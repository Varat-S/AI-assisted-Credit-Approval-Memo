  "evidence_sources": [
    {
      "document_id": "doc_10k",
      "evidence_id": "ev_payer",
      "excerpt": "Medicare and Medicaid accounted for 45% of our revenues. Our managed care contracts are generally multi-year agreements that set negotiated rates; the contracts do not guarantee minimum volumes of patients. Either party may terminate an agreement on notice.",
      "filename": "nfh-10k.htm",
      "form": "10-K",
      "heading": "Item 1",
      "location": 20000,
      "n": 1,
      "page": null,
      "sec_accession": "0000000001-26-000001",
      "section": "Item 1",
      "source_url": null
    },
    {
      "document_id": "doc_10k",
      "evidence_id": "ev_model",
      "excerpt": "We operate 48 hospitals and 120 outpatient facilities. Our sources of revenue are patient services provided at our facilities. Demand for acute care services is essential and admissions were stable during the year.",
      "filename": "nfh-10k.htm",
      "form": "10-K",
      "heading": "Item 1",
      "location": 18000,
      "n": 2,
      "page": null,
      "sec_accession": "0000000001-26-000001",
      "section": "Item 1",
      "source_url": null
    },
    {
      "document_id": "doc_10k",
      "evidence_id": "ev_labor",
      "excerpt": "We face a nursing shortage and rising contract labor costs. We operate a College of Nursing to expand our training pipeline, which we believe will improve recruitment and retention. There is no assurance these initiatives will be successful.",
      "filename": "nfh-10k.htm",
      "form": "10-K",
      "heading": "Item 1A",
      "location": 14000,
      "n": 3,
      "page": null,
      "sec_accession": "0000000001-26-000001",
      "section": "Item 1A",
      "source_url": null
    },
    {
      "document_id": "doc_10k",
      "evidence_id": "ev_compete",
      "excerpt": "We compete with other hospitals, including not-for-profit systems, and with ambulatory surgery centers. Competitors may have greater market share in certain markets. Revenue per equivalent admission increased 4.1% due to pricing, payer mix and case mix acuity. In 2025 we operated the largest hospital network by licensed beds in most of our markets.",
      "filename": "nfh-10k.htm",
      "form": "10-K",
      "heading": "Item 1",
      "location": 4000,
      "n": 4,
      "page": null,
      "sec_accession": "0000000001-26-000001",
      "section": "Item 1",
      "source_url": null
    },
    {
      "document_id": "doc_10k",
      "evidence_id": "ev_reg",
      "excerpt": "We are subject to extensive regulation. A significant portion of our revenues depends on government programs, and reimbursement rates may be reduced by legislation. We cannot predict the outcome of proposed legislation. We are party to litigation and government investigations.",
      "filename": "nfh-10k.htm",
      "form": "10-K",
      "heading": "Item 1A",
      "location": 22000,
      "n": 5,
      "page": null,
      "sec_accession": "0000000001-26-000001",
      "section": "Item 1A",
      "source_url": null
    },
    {
      "document_id": "doc_10k",
      "evidence_id": "ev_capex",
      "excerpt": "Capital expenditures were focused on expansion of existing facilities. We completed acquisitions of three hospitals during the year; integration of these facilities is ongoing.",
      "filename": "nfh-10k.htm",
      "form": "10-K",
      "heading": "Item 7",
      "location": 2000,
      "n": 6,
      "page": null,
      "sec_accession": "0000000001-26-000001",
      "section": "Item 7",
      "source_url": null
    },
    {
      "document_id": "doc_10k",
      "evidence_id": "ev_debt_maturity",
      "excerpt": "The senior notes have staggered maturities; the revolving credit facility is undrawn. Refinancing of maturing tranches occurred during the year.",
      "filename": "nfh-10k.htm",
      "form": "10-K",
      "heading": "Item 7",
      "location": 6000,
      "n": 7,
      "page": null,
      "sec_accession": "0000000001-26-000001",
      "section": "Item 7",
      "source_url": null
    },
    {
      "document_id": "doc_10k",
      "evidence_id": "ev_debt_notes",
      "excerpt": "Our long-term debt consists of senior unsecured notes with principal of $43,700 million issued by the operating company and guaranteed by the parent. Total indebtedness was $46,492 million at year end.",
      "filename": "nfh-10k.htm",
      "form": "10-K",
      "heading": "Item 8",
      "location": 8000,
      "n": 8,
      "page": null,
      "sec_accession": "0000000001-26-000001",
